    // ═══════════════════════════════════════════════════════════════════════
    // BUFFERED READER
    // ═══════════════════════════════════════════════════════════════════════
    static class BufReader {
        final Socket sock;
        byte[] buf = new byte[4096];
        int pos = 0, len = 0;
        BufReader(Socket sock) { this.sock = sock; }

        int fill(int want) throws IOException {
            while (len - pos < want) {
                if (pos > 0) {
                    System.arraycopy(buf, pos, buf, 0, len - pos);
                    len -= pos; pos = 0;
                }
                if (len == buf.length) {
                    byte[] nb = new byte[buf.length * 2];
                    System.arraycopy(buf, 0, nb, 0, len);
                    buf = nb;
                }
                int n = sock.getInputStream().read(buf, len, buf.length - len);
                if (n < 0) return len - pos;
                len += n;
            }
            return len - pos;
        }

        byte[] readExact(int n) throws IOException {
            if (n <= 0) return new byte[0];
            if (fill(n) < n) throw new EOFException("EOF");
            byte[] out = new byte[n];
            System.arraycopy(buf, pos, out, 0, n);
            pos += n;
            return out;
        }

        int readByte() throws IOException {
            if (fill(1) < 1) throw new EOFException("EOF");
            return buf[pos++] & 0xff;
        }

        String readLine(int max) throws IOException {
            ByteArrayOutputStream line = new ByteArrayOutputStream();
            while (true) {
                int c = readByte();
                if (c == '\n') {
                    byte[] b = line.toByteArray();
                    int n = b.length;
                    if (n > 0 && b[n - 1] == '\r') n--;
                    return new String(b, 0, n, StandardCharsets.ISO_8859_1);
                }
                if (line.size() >= max) throw new IOException("line too long");
                line.write(c);
            }
        }

        byte[] peekAll() {
            byte[] out = new byte[len - pos];
            System.arraycopy(buf, pos, out, 0, out.length);
            return out;
        }
        void clear() { pos = len = 0; }
    }

