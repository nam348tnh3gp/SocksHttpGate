    static final ConcurrentHashMap<String, Map<String,Object>> USAGE = new ConcurrentHashMap<>();
    static final Object USAGE_LOCK = new Object();
    static String currentPeriod() {
        ZonedDateTime now = ZonedDateTime.now();
        return String.format("%04d-%02d", now.getYear(), now.getMonthValue());
    }
    static long usageGet(String username) {
        if (username == null || username.isEmpty()) return 0;
        String per = currentPeriod();
        Map<String,Object> r = USAGE.get(username);
        if (r == null || !per.equals(r.get("period"))) return 0;
        Object b = r.get("bytes_used");
        return b instanceof Number ? ((Number) b).longValue() : 0;
    }
    static void usageAdd(String username, long n) {
        if (username == null || username.isEmpty() || n <= 0) return;
        String per = currentPeriod();
        synchronized (USAGE_LOCK) {
            Map<String,Object> r = USAGE.get(username);
            if (r == null || !per.equals(r.get("period"))) {
                r = new LinkedHashMap<>();
                r.put("period", per);
                r.put("bytes_used", 0L);
                USAGE.put(username, r);
            }
            long b = ((Number) r.get("bytes_used")).longValue();
            r.put("bytes_used", b + n);
        }
    }

    static final ConcurrentHashMap<String, AtomicInteger> FAIL_COUNTS = new ConcurrentHashMap<>();
    static final ConcurrentHashMap<String, Long> FAIL_LAST = new ConcurrentHashMap<>();
    static final ConcurrentHashMap<String, Long> BLOCKED_UNTIL = new ConcurrentHashMap<>();

    static void recordAuthFail(String ip, int threshold) {
        long now = System.currentTimeMillis();
        Long last = FAIL_LAST.get(ip);
        if (last != null && now - last < 2000) return;
        if (last != null && now - last > AUTH_FAIL_WINDOW * 1000L) {
            FAIL_COUNTS.put(ip, new AtomicInteger(0));
        }
        FAIL_LAST.put(ip, now);
        int c = FAIL_COUNTS.computeIfAbsent(ip, k -> new AtomicInteger()).incrementAndGet();
        if (c >= threshold) {
            BLOCKED_UNTIL.put(ip, now + AUTH_BLOCK_SECONDS * 1000L);
            FAIL_COUNTS.put(ip, new AtomicInteger(0));
            logWarn("IP " + ip + " bị chặn " + AUTH_BLOCK_SECONDS + "s do sai xác thực nhiều lần");
        }
    }
    static void resetAuthFail(String ip) {
        FAIL_COUNTS.remove(ip); FAIL_LAST.remove(ip); BLOCKED_UNTIL.remove(ip);
    }
    static boolean isAuthBlocked(String ip) {
        Long until = BLOCKED_UNTIL.get(ip);
        if (until == null) return false;
        if (System.currentTimeMillis() > until) { BLOCKED_UNTIL.remove(ip); return false; }
        return true;
    }
    static boolean isIpAllowed(String ip) {
        if (Ssrf.ipInNets(ip, DENIED_CIDRS)) return false;
        if (ALLOWED_CIDRS.isEmpty()) return true;
        return Ssrf.ipInNets(ip, ALLOWED_CIDRS);
    }

