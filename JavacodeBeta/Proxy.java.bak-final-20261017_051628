    static Map<String,Object> statsAll() {
        Map<String,Object> d = statsBasic();
        List<Object> conns = new ArrayList<>();
        long now = System.currentTimeMillis();
        for (ConnectionInfo c : ACTIVE_CONNS.values()) {
            Map<String,Object> cm = new LinkedHashMap<>();
            cm.put("id", c.id); cm.put("ip", c.ip); cm.put("port", c.port);
            cm.put("type", c.type); cm.put("target", c.target); cm.put("user", c.username);
            cm.put("start_time", c.startMs / 1000.0);
            cm.put("bytes_up", c.bytesUp.get());
            cm.put("bytes_down", c.bytesDown.get());
            cm.put("duration", (now - c.startMs) / 1000.0);
            conns.add(cm);
        }
        d.put("active_connections", conns);

        List<Object> ups = new ArrayList<>();
        List<Object> upsStatus = new ArrayList<>();
        for (String[] u : UPSTREAM_PROXIES) {
            String key = u[0] + ":" + u[1];
            ups.add(key);
            Map<String,Object> sm = new LinkedHashMap<>();
            sm.put("addr", key);
            sm.put("alive", UPSTREAM_HEALTH.getOrDefault(key, true));
            upsStatus.add(sm);
        }
        Map<String,Object> up = new LinkedHashMap<>();
        up.put("proxies", ups);
        up.put("current_index", UPSTREAM_IDX.get());
        up.put("status", upsStatus);
        d.put("upstream", up);

        Map<String,Object> sys = new LinkedHashMap<>();
        sys.put("cpu_percent", 0.0);
        sys.put("memory_percent", 0.0);
        sys.put("fd_limit", 65536);
        d.put("system", sys);

        Map<String,Object> udpInfo = new LinkedHashMap<>();
        for (Map.Entry<String,UdpAssoc> e : UDP_ASSOCS.entrySet()) {
            Map<String,Object> um = new LinkedHashMap<>();
            um.put("active", true);
            um.put("dest_count", e.getValue().destCount.get());
            um.put("last_activity", e.getValue().lastActivity / 1000);
            udpInfo.put(e.getKey(), um);
        }
        d.put("udp_associations", udpInfo);
        return d;
    }

