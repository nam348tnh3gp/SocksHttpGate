                while (true) {
                    ws();
                    if (peek() != '"') throw new RuntimeException("expected key");
                    String k = str();
                    ws();
                    if (peek() != ':') throw new RuntimeException("expected ':'");
                    i++;
                    Object v = val();
                    m.put(k, v);
                    ws();
                    if (peek() == ',') { i++; continue; }
                    if (peek() == '}') { i++; return m; }
                    throw new RuntimeException("expected ',' or '}'");
                }
