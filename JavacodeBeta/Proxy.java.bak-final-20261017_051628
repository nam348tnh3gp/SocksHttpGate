    // ═══════════════════════════════════════════════════════════════════════
    // UPSTREAM
    // ═══════════════════════════════════════════════════════════════════════
    static Socket tryConnect(String host, int port, int timeoutMs) {
        try {
            Socket s = new Socket();
            s.connect(new InetSocketAddress(host, port), timeoutMs);
            s.setKeepAlive(true);
            return s;
        } catch (Exception e) { return null; }
    }

    static Socket connectTarget(String host, int port) {
        List<String[]> ups = UPSTREAM_PROXIES;
        int start = UPSTREAM_IDX.get();
        if (!ups.isEmpty()) {
            int total = ups.size();
            int aliveN = 0;
            for (String[] u : ups) if (UPSTREAM_HEALTH.getOrDefault(u[0] + ":" + u[1], true)) aliveN++;
            for (int i = 0; i < total; i++) {
                int idx = (start + i) % total;
                String[] u = ups.get(idx);
                String key = u[0] + ":" + u[1];
                if (aliveN > 0 && !UPSTREAM_HEALTH.getOrDefault(key, true)) continue;
                UPSTREAM_IDX.set((idx + 1) % total);
                Socket s = tryConnect(u[0], Integer.parseInt(u[1]), CONN_TIMEOUT_MS);
                if (s != null) { UPSTREAM_HEALTH.put(key, true); return s; }
                UPSTREAM_HEALTH.put(key, false);
            }
        }
        List<InetSocketAddress> addrs = resolveTarget(host, port);
        if (addrs == null) return null;
        for (InetSocketAddress addr : addrs) {
            for (int attempt = 0; attempt < 2; attempt++) {
                Socket s = tryConnect(addr.getAddress().getHostAddress(), addr.getPort(), CONN_TIMEOUT_MS);
                if (s != null) return s;
                try { Thread.sleep(500L * (attempt + 1)); } catch (InterruptedException ignored) {}
            }
        }
        return null;
    }

    static List<InetSocketAddress> resolveTarget(String host, int port) {
        try {
            InetAddress[] all = InetAddress.getAllByName(host);
            List<InetSocketAddress> out = new ArrayList<>();
            for (InetAddress ia : all) {
                if (Ssrf.isBlocked(ia)) {
                    logWarn(RED + "TCP connect chặn " + host + " → " + ia.getHostAddress() + RESET);
                    return null;
                }
                out.add(new InetSocketAddress(ia, port));
            }
            return out.isEmpty() ? null : out;
        } catch (Exception e) { return null; }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // TUNNEL
    // ═══════════════════════════════════════════════════════════════════════
    static void tunnel(Socket client, Socket remote, ConnectionInfo ci, byte[] initial) {
        try {
            if (initial != null && initial.length > 0) {
                remote.getOutputStream().write(initial);
                STATS.bytesUp.addAndGet(initial.length);
                if (ci != null) { ci.bytesUp.addAndGet(initial.length); usageAdd(ci.username, initial.length); }
            }
            client.setSoTimeout(IDLE_TIMEOUT_MS);
            remote.setSoTimeout(IDLE_TIMEOUT_MS);

            Thread t = Thread.ofVirtual().start(() -> {
                try { relay(remote, client, ci, true); }
                finally {
                    try { remote.close(); } catch (Exception ignored) {}
                    try { client.close(); } catch (Exception ignored) {}
                }
            });
            relay(client, remote, ci, false);
            t.join(1000);
        } catch (Exception ignored) {
        } finally {
            try { client.close(); } catch (Exception ignored) {}
            try { remote.close(); } catch (Exception ignored) {}
        }
    }

    static void relay(Socket src, Socket dst, ConnectionInfo ci, boolean downstream) {
        byte[] buf = new byte[BUF_SIZE];
        try {
            InputStream in = src.getInputStream();
            OutputStream out = dst.getOutputStream();
            while (!SHUTDOWN) {
                int n = in.read(buf);
                if (n < 0) break;
                out.write(buf, 0, n);
                out.flush();
                if (downstream) {
                    STATS.bytesDown.addAndGet(n);
                    if (ci != null) { ci.bytesDown.addAndGet(n); usageAdd(ci.username, n); throttle(ci, n); }
                } else {
                    STATS.bytesUp.addAndGet(n);
                    if (ci != null) { ci.bytesUp.addAndGet(n); usageAdd(ci.username, n); throttle(ci, n); }
                }
            }
        } catch (Exception ignored) {}
    }

    static void throttle(ConnectionInfo ci, long n) {
        if (ci == null) return;
        long r = ci.rateBps;
        if (r <= 0) return;
        double delay = Math.min(1.5, n / (double) r);
        if (delay > 0.0005) try { Thread.sleep((long)(delay * 1000)); } catch (InterruptedException ignored) {}
    }

    // ═══════════════════════════════════════════════════════════════════════
    // SOCKS5 REPLY
    // ═══════════════════════════════════════════════════════════════════════
    static void socks5Reply(Socket sock, int rep, String addr, int port) {
        try {
            OutputStream o = sock.getOutputStream();
            String a = normalizeIp(addr);
            boolean v6 = a.contains(":");
            byte[] ipBytes;
            int atyp;
            if (v6) { atyp = 4; ipBytes = InetAddress.getByName(a).getAddress(); }
            else {
                atyp = 1;
                ipBytes = new byte[4];
                String[] p = a.split("\\.");
                for (int i = 0; i < 4; i++) ipBytes[i] = (byte) Integer.parseInt(p[i]);
            }
            byte[] r = new byte[4 + ipBytes.length + 2];
            r[0] = 5; r[1] = (byte) rep; r[2] = 0; r[3] = (byte) atyp;
            System.arraycopy(ipBytes, 0, r, 4, ipBytes.length);
            r[4 + ipBytes.length] = (byte) ((port >> 8) & 0xff);
            r[4 + ipBytes.length + 1] = (byte) (port & 0xff);
            o.write(r);
            o.flush();
        } catch (Exception ignored) {}
    }

    // ═══════════════════════════════════════════════════════════════════════
    // AUTH
    // ═══════════════════════════════════════════════════════════════════════
    static class AuthResult {
        boolean ok; long rateBps; String username = "";
    }
    static AuthResult authenticateProxyUser(String user, String password) {
        AuthResult r = new AuthResult();
        if (OPTS.authRequired && ctEqual(user, OPTS.username) && ctEqual(password, OPTS.password)) {
            r.ok = true; r.username = user; return r;
        }
        for (ProxyUser u : CFG.users) {
            if (ctEqual(u.username, user) && verifyPasswordCached(password, u.passwordHash)) {
                r.ok = true; r.rateBps = u.maxBandwidthBps; r.username = u.username;
                return r;
            }
        }
        return r;
    }

    static class LimitResult { boolean allowed; String reason = ""; }
    static LimitResult checkUserLimits(String username) {
        LimitResult r = new LimitResult(); r.allowed = true;
        if (username == null || username.isEmpty()) return r;
        ProxyUser u = null;
        for (ProxyUser pu : CFG.users) if (pu.username.equals(username)) { u = pu; break; }
        if (u == null) return r;
        if (u.maxConnections > 0) {
            long n = ACTIVE_CONNS.values().stream().filter(c -> username.equals(c.username)).count();
            if (n >= u.maxConnections) {
                r.allowed = false;
                r.reason = "đã đạt giới hạn " + u.maxConnections + " connection đồng thời";
                return r;
            }
        }
        if (u.quotaBytesPerMonth > 0 && usageGet(username) >= u.quotaBytesPerMonth) {
            r.allowed = false;
            r.reason = "đã vượt quota dung lượng tháng";
        }
        return r;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // SOCKS5
    // ═══════════════════════════════════════════════════════════════════════
    static void handleSocks5(Socket sock, BufReader reader, String cip, int cport) {
        ConnectionInfo ci = null;
        try {
            byte[] hdr = reader.readExact(2);
            if ((hdr[0] & 0xff) != 5) return;
            int nmethods = hdr[1] & 0xff;
            byte[] methods = nmethods > 0 ? reader.readExact(nmethods) : new byte[0];
            boolean needAuth = proxyAuthRequired();
            int want = needAuth ? 0x02 : 0x00;
            boolean found = false;
            for (byte m : methods) if ((m & 0xff) == want) { found = true; break; }
            if (!found) { sock.getOutputStream().write(new byte[]{5, (byte) 0xff}); return; }
            sock.getOutputStream().write(new byte[]{5, (byte) want});

            String username = ""; long rateBps = 0;
            if (needAuth) {
                int aVer = reader.readByte();
                if (aVer != 1) { sock.getOutputStream().write(new byte[]{1, (byte) 0xff}); return; }
                int ulen = reader.readByte();
                String u = new String(reader.readExact(ulen), StandardCharsets.UTF_8);
                int plen = reader.readByte();
                String p = new String(reader.readExact(plen), StandardCharsets.UTF_8);
                AuthResult ar = authenticateProxyUser(u, p);
                sock.getOutputStream().write(ar.ok ? new byte[]{1, 0} : new byte[]{1, (byte) 0xff});
                if (!ar.ok) {
                    logWarn(RED + "SOCKS5 auth fail from " + cip + RESET);
                    STATS.authFail.incrementAndGet();
                    recordAuthFail(cip, AUTH_FAIL_THRESHOLD);
                    return;
                }
                resetAuthFail(cip);
                username = ar.username;
                rateBps = ar.rateBps;
                LimitResult lr = checkUserLimits(username);
                if (!lr.allowed) {
                    logWarn("SOCKS5 từ chối user '" + username + "': " + lr.reason);
                    socks5Reply(sock, 0x02, "0.0.0.0", 0);
                    return;
                }
            }

            byte[] req = reader.readExact(4);
            int cmd = req[1] & 0xff;
            int atyp = req[3] & 0xff;
            String host; int port;
            switch (atyp) {
                case 1: {
                    byte[] ip = reader.readExact(4);
                    host = (ip[0]&0xff)+"."+(ip[1]&0xff)+"."+(ip[2]&0xff)+"."+(ip[3]&0xff);
                    break;
                }
                case 3: {
                    int ln = reader.readByte();
                    if (ln == 0) { socks5Reply(sock, 0x04, "0.0.0.0", 0); return; }
                    host = new String(reader.readExact(ln), StandardCharsets.US_ASCII);
                    break;
                }
                case 4: {
                    byte[] ip = reader.readExact(16);
                    host = InetAddress.getByAddress(ip).getHostAddress();
                    break;
                }
                default:
                    socks5Reply(sock, 0x08, "0.0.0.0", 0);
                    return;
            }
            byte[] pb = reader.readExact(2);
            port = ((pb[0]&0xff)<<8) | (pb[1]&0xff);

            if (cmd == CMD_CONNECT) {
                String target = host + ":" + port;
                log(GREEN + "SOCKS5 TCP → " + cip + ":" + cport + " → " + target + RESET);
                sock.setSoTimeout(0);
                Socket remote = connectTarget(host, port);
                if (remote == null) { socks5Reply(sock, 0x05, "0.0.0.0", 0); return; }
                InetAddress bnd = remote.getLocalAddress();
                int bndPort = remote.getLocalPort();
                socks5Reply(sock, 0x00, bnd.getHostAddress(), bndPort);

                ci = new ConnectionInfo(nextConnId(), cip, cport, "SOCKS5_TCP",
                    target, rateBps, username, sock);
                ACTIVE_CONNS.put(ci.id, ci);
                STATS.socks5Tcp.incrementAndGet();

                byte[] initial = reader.peekAll();
                reader.clear();
                tunnel(sock, remote, ci, initial);
            } else if (cmd == CMD_UDP) {
                if (!OPTS.enableUdp) { socks5Reply(sock, 0x07, "0.0.0.0", 0); return; }
                handleUdpAssociate(sock, reader, cip, cport, host, port, username, rateBps);
            } else {
                socks5Reply(sock, 0x07, "0.0.0.0", 0);
            }
        } catch (EOFException ignored) {
        } catch (Exception e) {
            logErr("SOCKS5 error: " + e.getMessage());
        } finally {
            if (ci != null) ACTIVE_CONNS.remove(ci.id);
        }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // SOCKS5 UDP ASSOCIATE
    // ═══════════════════════════════════════════════════════════════════════
    static void handleUdpAssociate(Socket tcp, BufReader reader, String cip, int cport,
                                    String host, int port, String username, long rateBps) {
        String target = (host == null || host.isEmpty()) ? "UDP:any" : "UDP:" + host + ":" + port;
        log(PURPLE + "UDP Associate → " + cip + ":" + cport + " → " + target + RESET);

        DatagramSocket relay;
        try {
            relay = new DatagramSocket(new InetSocketAddress("0.0.0.0", 0));
            relay.setSoTimeout(1000);
        } catch (Exception e) {
            logErr("UDP relay bind failed: " + e.getMessage());
            socks5Reply(tcp, 0x01, "0.0.0.0", 0);
            return;
        }
        int relayPort = relay.getLocalPort();

        String key = cip + ":" + cport + ":" + relayPort;
        UdpAssoc assoc = new UdpAssoc();
        UDP_ASSOCS.put(key, assoc);

        ConnectionInfo ci = new ConnectionInfo(nextConnId(), cip, cport, "SOCKS5_UDP",
            target, rateBps, username, tcp);
        ACTIVE_CONNS.put(ci.id, ci);
        STATS.udpAssocs.incrementAndGet();
        STATS.socks5Udp.incrementAndGet();

        // FIX v6.3.6: BND.ADDR = IP của PROXY
        String proxyIp = tcp.getLocalAddress().getHostAddress();
        socks5Reply(tcp, 0x00, proxyIp, relayPort);
        log(PURPLE + "UDP reply sent → client dùng " + normalizeIp(proxyIp) + ":" + relayPort + RESET);

        try { tcp.setSoTimeout(0); } catch (Exception ignored) {}

        byte[] buf = new byte[UDP_BUF_SIZE];
        InetSocketAddress clientUdp = null;
        Map<String, Long> destMap = new HashMap<>();

        try {
            while (!SHUTDOWN) {
                if (System.currentTimeMillis() - assoc.lastActivity > UDP_IDLE_MS) {
                    log("UDP association idle-expired (" + cip + ":" + cport + ")");
                    break;
                }

                // Check control channel
                try {
                    tcp.setSoTimeout(10);
                    int b = tcp.getInputStream().read();
                    if (b < 0) { log("UDP control TCP closed (" + cip + ":" + cport + ")"); break; }
                } catch (SocketTimeoutException ignored) {
                } catch (Exception e) { break; }

                try {
                    DatagramPacket pkt = new DatagramPacket(buf, buf.length);
                    relay.receive(pkt);
                    assoc.lastActivity = System.currentTimeMillis();
                    InetAddress srcAddr = pkt.getAddress();
                    int srcPort = pkt.getPort();
                    String srcIp = normalizeIp(srcAddr.getHostAddress());

                    if (clientUdp == null) {
                        if (!srcIp.equals(cip)) {
                            logWarn(RED + "UDP: bỏ packet từ " + srcIp + ":" + srcPort + " (không khớp " + cip + ")" + RESET);
                            continue;
                        }
                        clientUdp = new InetSocketAddress(srcAddr, srcPort);
                        log(PURPLE + "UDP client learned: " + srcIp + ":" + srcPort + RESET);
                    }

                    byte[] data = Arrays.copyOf(pkt.getData(), pkt.getLength());
                    if (srcAddr.equals(clientUdp.getAddress()) && srcPort == clientUdp.getPort()) {
                        udpToDest(relay, data, destMap, ci, assoc);
                    } else {
                        udpToClient(relay, data, srcAddr, srcPort, clientUdp, destMap, ci);
                    }
                } catch (SocketTimeoutException ignored) {}
            }
        } catch (Exception e) {
            logErr("UDP loop error: " + e.getMessage());
        } finally {
            try { relay.close(); } catch (Exception ignored) {}
            UDP_ASSOCS.remove(key);
            ACTIVE_CONNS.remove(ci.id);
            STATS.udpAssocs.decrementAndGet();
            log("UDP association ended (" + cip + ":" + cport + ")");
        }
    }

    static void udpToDest(DatagramSocket relay, byte[] data, Map<String, Long> destMap,
                          ConnectionInfo ci, UdpAssoc assoc) {
        if (data.length < 4 || data[2] != 0) return;
        int atyp = data[3] & 0xff;
        int pos = 4;
        String host;
        try {
            if (atyp == 1) {
                if (data.length < pos + 6) return;
                host = (data[pos]&0xff)+"."+(data[pos+1]&0xff)+"."+(data[pos+2]&0xff)+"."+(data[pos+3]&0xff);
                pos += 4;
            } else if (atyp == 3) {
                if (data.length < pos + 1) return;
                int ln = data[pos] & 0xff; pos++;
                if (ln == 0 || data.length < pos + ln + 2) return;
                host = new String(data, pos, ln, StandardCharsets.US_ASCII);
                pos += ln;
            } else if (atyp == 4) {
                if (data.length < pos + 18) return;
                host = InetAddress.getByAddress(Arrays.copyOfRange(data, pos, pos + 16)).getHostAddress();
                pos += 16;
            } else return;
            int port = ((data[pos]&0xff)<<8) | (data[pos+1]&0xff);
            pos += 2;
            byte[] payload = Arrays.copyOfRange(data, pos, data.length);

            InetAddress destAddr = InetAddress.getByName(host);
            if (Ssrf.isBlocked(destAddr)) {
                logWarn(RED + "UDP relay bỏ target bị chặn: " + host + ":" + port + RESET);
                return;
            }
            relay.send(new DatagramPacket(payload, payload.length, destAddr, port));

            if (destMap.size() >= UDP_DEST_MAX) destMap.clear();
            String dk = destAddr.getHostAddress() + ":" + port;
            boolean isNew = !destMap.containsKey(dk);
            destMap.put(dk, System.currentTimeMillis());
            if (isNew) assoc.destCount.incrementAndGet();

            STATS.udpUp.addAndGet(payload.length);
            usageAdd(ci.username, payload.length);
        } catch (Exception e) {
            logWarn(RED + "UDP sendto failed: " + e.getMessage() + RESET);
        }
    }

    static void udpToClient(DatagramSocket relay, byte[] data, InetAddress srcAddr, int srcPort,
                            InetSocketAddress clientUdp, Map<String, Long> destMap, ConnectionInfo ci) {
        String srcIp = normalizeIp(srcAddr.getHostAddress());
        String dk = srcIp + ":" + srcPort;
        if (!destMap.containsKey(dk)) return;
        try {
            byte[] ipBytes = srcAddr.getAddress();
            int atyp = ipBytes.length == 16 ? 4 : 1;
            ByteArrayOutputStream out = new ByteArrayOutputStream();
            out.write(0); out.write(0); out.write(0); out.write(atyp);
            out.write(ipBytes);
            out.write((srcPort >> 8) & 0xff);
            out.write(srcPort & 0xff);
            out.write(data);
            byte[] full = out.toByteArray();
            relay.send(new DatagramPacket(full, full.length, clientUdp.getAddress(), clientUdp.getPort()));
            STATS.udpDown.addAndGet(data.length);
            usageAdd(ci.username, data.length);
        } catch (Exception e) {
            logWarn(RED + "UDP reply→client failed: " + e.getMessage() + RESET);
        }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // HTTP
    // ═══════════════════════════════════════════════════════════════════════
    static void handleHttp(Socket sock, BufReader reader, String cip, int cport) {
        ConnectionInfo ci = null;
        Socket remote = null;
        try {
            String reqLine = reader.readLine(8192);
            if (reqLine == null) return;
            String[] parts = reqLine.split("\\s+");
            if (parts.length < 2) return;
            String method = parts[0].toUpperCase();
            String url = parts[1];

            Map<String, List<String>> headers = new LinkedHashMap<>();
            for (int i = 0; i < 200; i++) {
                String line = reader.readLine(8192);
                if (line == null) return;
                if (line.isEmpty()) break;
                int idx = line.indexOf(':');
                if (idx <= 0) continue;
                String k = line.substring(0, idx).trim().toLowerCase();
                String v = line.substring(idx + 1).trim();
                headers.computeIfAbsent(k, x -> new ArrayList<>()).add(v);
            }

            // FIX v6.3.6: smuggling
            List<String> clVals = headers.get("content-length");
            List<String> teVals = headers.get("transfer-encoding");
            if (clVals != null && teVals != null) {
                logWarn(RED + "HTTP smuggling: CL+TE (" + cip + ")" + RESET);
                sendSimple(sock, 400, "Bad Request"); return;
            }
            if (clVals != null && clVals.size() > 1) {
                Set<String> uniq = new HashSet<>();
                for (String v : clVals) uniq.add(v.trim());
                if (uniq.size() != 1) {
                    logWarn(RED + "HTTP smuggling: Content-Length xung đột" + RESET);
                    sendSimple(sock, 400, "Bad Request"); return;
                }
            }
            if (teVals != null) {
                if (teVals.size() > 1 || !teVals.get(0).trim().equalsIgnoreCase("chunked")) {
                    logWarn(RED + "HTTP smuggling: TE bất thường" + RESET);
                    sendSimple(sock, 400, "Bad Request"); return;
                }
            }

            String username = ""; long rateBps = 0;
            if (proxyAuthRequired()) {
                List<String> pa = headers.get("proxy-authorization");
                String a = pa == null || pa.isEmpty() ? "" : pa.get(pa.size() - 1);
                boolean ok = false;
                if (a.toLowerCase().startsWith("basic ")) {
                    try {
                        String cred = new String(Base64.getDecoder().decode(a.substring(6).trim()),
                                                  StandardCharsets.UTF_8);
                        int idx = cred.indexOf(':');
                        if (idx > 0) {
                            AuthResult ar = authenticateProxyUser(cred.substring(0, idx), cred.substring(idx + 1));
                            ok = ar.ok;
                            username = ar.username;
                            rateBps = ar.rateBps;
                        }
                    } catch (Exception ignored) {}
                }
                if (!ok) {
                    String resp = "HTTP/1.1 407 Proxy Authentication Required\r\n"
                                + "Proxy-Authenticate: Basic realm=\"Proxy\"\r\n"
                                + "Connection: close\r\n\r\n";
                    sock.getOutputStream().write(resp.getBytes(StandardCharsets.ISO_8859_1));
                    STATS.authFail.incrementAndGet();
                    recordAuthFail(cip, AUTH_FAIL_THRESHOLD);
                    return;
                }
                resetAuthFail(cip);
                LimitResult lr = checkUserLimits(username);
                if (!lr.allowed) {
                    String resp = "HTTP/1.1 429 Too Many Requests\r\nConnection: close\r\n\r\n" + lr.reason;
                    sock.getOutputStream().write(resp.getBytes(StandardCharsets.UTF_8));
                    return;
                }
            }

            String host; int port;
            if (method.equals("CONNECT")) {
                if (url.startsWith("[")) {
                    int end = url.indexOf(']');
                    if (end < 0) { sendSimple(sock, 400, "Bad Request"); return; }
                    host = url.substring(1, end);
                    String rest = url.substring(end + 1);
                    if (!rest.startsWith(":")) { sendSimple(sock, 400, "Bad Request"); return; }
                    try { port = Integer.parseInt(rest.substring(1)); }
                    catch (NumberFormatException e) { sendSimple(sock, 400, "Bad Request"); return; }
                } else {
                    int idx = url.lastIndexOf(':');
                    if (idx < 0) { host = url; port = 443; }
                    else {
                        host = url.substring(0, idx);
                        try { port = Integer.parseInt(url.substring(idx + 1)); }
                        catch (NumberFormatException e) { sendSimple(sock, 400, "Bad Request"); return; }
                    }
                }
                if (port < 1 || port > 65535) { sendSimple(sock, 400, "Bad Request"); return; }
            } else {
                try {
                    String u = url.startsWith("http://") || url.startsWith("https://") ? url : "http://" + url;
                    URI uri = new URI(u);
                    host = uri.getHost();
                    port = uri.getPort() > 0 ? uri.getPort() : ("https".equals(uri.getScheme()) ? 443 : 80);
                    if (host == null) { sendSimple(sock, 400, "Bad Request"); return; }
                } catch (Exception e) { sendSimple(sock, 400, "Bad Request"); return; }
            }

            String target = host + ":" + port;
            log(GREEN + "HTTP " + method + " → " + cip + ":" + cport + " → " + target + RESET);
            ci = new ConnectionInfo(nextConnId(), cip, cport, "HTTP", target, rateBps, username, sock);
            ACTIVE_CONNS.put(ci.id, ci);
            STATS.http.incrementAndGet();

            sock.setSoTimeout(0);
            remote = connectTarget(host, port);
            if (remote == null) { sendSimple(sock, 502, "Bad Gateway"); return; }

            if (method.equals("CONNECT")) {
                sock.getOutputStream().write("HTTP/1.1 200 Connection Established\r\n\r\n".getBytes(StandardCharsets.ISO_8859_1));
                byte[] initial = reader.peekAll();
                reader.clear();
                tunnel(sock, remote, ci, initial);
            } else {
                forwardHttp(method, url, headers, remote, ci, reader);
                forwardResponse(remote, sock, ci);
            }
        } catch (EOFException ignored) {
        } catch (Exception e) {
            logErr("HTTP error: " + e.getMessage());
        } finally {
            try { if (remote != null) remote.close(); } catch (Exception ignored) {}
            if (ci != null) ACTIVE_CONNS.remove(ci.id);
        }
    }

    static void sendSimple(Socket sock, int code, String text) {
        try {
            String body = code + " " + text + "\n";
            byte[] bodyB = body.getBytes(StandardCharsets.UTF_8);
            String resp = "HTTP/1.1 " + code + " " + text + "\r\n"
                        + "Connection: close\r\n"
                        + "Content-Length: " + bodyB.length + "\r\n\r\n";
            sock.getOutputStream().write(resp.getBytes(StandardCharsets.ISO_8859_1));
            sock.getOutputStream().write(bodyB);
            sock.getOutputStream().flush();
        } catch (Exception ignored) {}
    }

    static void forwardHttp(String method, String url, Map<String, List<String>> headers,
                            Socket remote, ConnectionInfo ci, BufReader reader) {
        try {
            URI uri = new URI(url.startsWith("http://") || url.startsWith("https://") ? url : "http://" + url);
            String path = uri.getRawPath();
            if (path == null || path.isEmpty()) path = "/";
            if (uri.getRawQuery() != null) path += "?" + uri.getRawQuery();

            StringBuilder sb = new StringBuilder();
            sb.append(method).append(' ').append(path).append(" HTTP/1.1\r\n");
            if (!headers.containsKey("host")) sb.append("Host: ").append(uri.getHost()).append("\r\n");
            for (Map.Entry<String, List<String>> e : headers.entrySet()) {
                String k = e.getKey();
                if (k.equals("proxy-authorization") || k.equals("proxy-connection") || k.equals("connection")) continue;
                for (String v : e.getValue()) {
                    String[] ps = k.split("-");
                    StringBuilder kc = new StringBuilder();
                    for (int i = 0; i < ps.length; i++) {
                        if (i > 0) kc.append('-');
                        if (!ps[i].isEmpty())
                            kc.append(Character.toUpperCase(ps[i].charAt(0))).append(ps[i].substring(1));
                    }
                    sb.append(kc).append(": ").append(v).append("\r\n");
                }
            }
            sb.append("Connection: close\r\n\r\n");
            byte[] reqBytes = sb.toString().getBytes(StandardCharsets.ISO_8859_1);
            remote.getOutputStream().write(reqBytes);
            ci.bytesUp.addAndGet(reqBytes.length);
            usageAdd(ci.username, reqBytes.length);

            List<String> clVals = headers.get("content-length");
            List<String> teVals = headers.get("transfer-encoding");
            if (clVals != null) {
                long rem = Long.parseLong(clVals.get(0).trim());
                while (rem > 0) {
                    int want = (int) Math.min(rem, BUF_SIZE);
                    byte[] chunk = reader.readExact(want);
                    remote.getOutputStream().write(chunk);
                    ci.bytesUp.addAndGet(chunk.length);
                    usageAdd(ci.username, chunk.length);
                    throttle(ci, chunk.length);
                    rem -= chunk.length;
                }
            } else if (teVals != null && teVals.get(0).trim().equalsIgnoreCase("chunked")) {
                while (true) {
                    String line = reader.readLine(1024);
                    if (line == null) break;
                    long size;
                    try { size = Long.parseLong(line.split(";")[0].trim(), 16); } catch (Exception e) { break; }
                    if (size == 0) {
                        while (true) { String t = reader.readLine(8192); if (t == null || t.isEmpty()) break; }
                        break;
                    }
                    if (size > 64L * 1024 * 1024) break;
                    byte[] chunk = reader.readExact((int) size);
                    byte[] crlf = reader.readExact(2);
                    if (crlf[0] != '\r' || crlf[1] != '\n') break;
                    remote.getOutputStream().write(chunk);
                    ci.bytesUp.addAndGet(chunk.length);
                    usageAdd(ci.username, chunk.length);
                    throttle(ci, chunk.length);
                }
            }
        } catch (Exception e) {
            logErr("forwardHttp: " + e.getMessage());
        }
    }

    static void forwardResponse(Socket src, Socket dst, ConnectionInfo ci) {
        byte[] buf = new byte[BUF_SIZE];
        try {
            src.setSoTimeout(IDLE_TIMEOUT_MS);
            InputStream in = src.getInputStream();
            OutputStream out = dst.getOutputStream();
            while (true) {
                int n = in.read(buf);
                if (n < 0) break;
                out.write(buf, 0, n);
                out.flush();
                STATS.bytesDown.addAndGet(n);
                if (ci != null) { ci.bytesDown.addAndGet(n); usageAdd(ci.username, n); throttle(ci, n); }
            }
        } catch (Exception ignored) {}
    }

    // ═══════════════════════════════════════════════════════════════════════
    // CONNECTION DISPATCH
    // ═══════════════════════════════════════════════════════════════════════
    static void handleConn(Socket sock) {
        String cip = ""; int cport = 0;
        try {
            InetSocketAddress peer = (InetSocketAddress) sock.getRemoteSocketAddress();
            cip = normalizeIp(peer.getAddress().getHostAddress());
            cport = peer.getPort();

            if (STATS.current.get() >= MAX_CONN) return;
            STATS.total.incrementAndGet();
            STATS.current.incrementAndGet();

            if (!isIpAllowed(cip)) {
                logWarn("IP " + cip + " bị từ chối (whitelist/blacklist)");
                return;
            }
            if (isAuthBlocked(cip)) {
                logWarn("IP " + cip + " đang bị chặn do auth fail");
                return;
            }

            sock.setSoTimeout(HANDSHAKE_TIMEOUT_MS);
            BufReader reader = new BufReader(sock);
            if (reader.fill(1) < 1) return;
            int fb = reader.buf[reader.pos] & 0xff;

            if (fb == SOCKS5_VER) handleSocks5(sock, reader, cip, cport);
            else if (HTTP_FIRST_BYTES.contains(fb)) handleHttp(sock, reader, cip, cport);
            else logWarn("Unknown protocol từ " + cip + ":" + cport + " (byte=" + String.format("0x%02x", fb) + ")");
        } catch (SocketTimeoutException ignored) {
        } catch (Exception e) {
            logErr("Handler error " + cip + ":" + cport + " → " + e.getMessage());
        } finally {
            STATS.current.decrementAndGet();
            try { sock.close(); } catch (Exception ignored) {}
        }
    }

