    static class Cidr {
        final byte[] addr = new byte[16];
        final int prefix;
        Cidr(String spec) throws Exception {
            String s = spec.trim();
            int slash = s.indexOf('/');
            String ipPart = slash < 0 ? s : s.substring(0, slash);
            boolean isV6 = ipPart.contains(":");
            int pfx = slash < 0 ? (isV6 ? 128 : 32) : Integer.parseInt(s.substring(slash + 1));
            if (isV6) {
                if (pfx > 128) throw new IllegalArgumentException("v6 pfx > 128");
                byte[] raw = InetAddress.getByName(ipPart).getAddress();
                if (raw.length != 16) throw new IllegalArgumentException("bad v6");
                System.arraycopy(raw, 0, addr, 0, 16);
                prefix = pfx;
            } else {
                if (pfx > 32) throw new IllegalArgumentException("v4 pfx > 32");
                byte[] raw = InetAddress.getByName(ipPart).getAddress();
                if (raw.length != 4) throw new IllegalArgumentException("bad v4");
                addr[10] = (byte) 0xff; addr[11] = (byte) 0xff;
                System.arraycopy(raw, 0, addr, 12, 4);
                prefix = 96 + pfx;
            }
        }
        boolean contains(byte[] ip) {
            int full = prefix / 8, rem = prefix % 8;
            for (int i = 0; i < full; i++) if (addr[i] != ip[i]) return false;
            if (rem > 0) {
                int mask = 0xFF << (8 - rem);
                if ((addr[full] & mask) != (ip[full] & mask)) return false;
            }
            return true;
        }
    }

    static class Ssrf {
        static boolean isBlocked(InetAddress ia) {
            if (ia == null) return true;
            byte[] raw = ia.getAddress();
            if (raw.length == 4) return isBlockedV4(raw);
            byte[] canon = new byte[16];
            System.arraycopy(raw, 0, canon, 0, 16);
            // IPv4-mapped
            if (canon[10] == (byte) 0xff && canon[11] == (byte) 0xff) {
                byte[] v4 = new byte[4];
                System.arraycopy(canon, 12, v4, 0, 4);
                return isBlockedV4(v4);
            }
            return isBlockedV6(canon);
        }
        static boolean isBlockedV4(byte[] p) {
            int a = p[0] & 0xff, b = p[1] & 0xff, c = p[2] & 0xff;
            if (a == 0 || a == 10 || a == 127) return true;
            if (a == 100 && (b & 0xc0) == 64) return true;
            if (a == 169 && b == 254) return true;
            if (a == 172 && (b & 0xf0) == 16) return true;
            if (a == 192 && b == 168) return true;
            if (a == 192 && b == 0 && c == 0) return true;
            if (a == 198 && (b & 0xfe) == 18) return true;
            if (a >= 224) return true;
            return false;
        }
        static boolean isBlockedV6(byte[] p) {
            boolean zero12 = true;
            for (int i = 0; i < 12; i++) if (p[i] != 0) { zero12 = false; break; }
            if (zero12) return true;
            if ((p[0] & 0xfe) == 0xfc) return true;
            if ((p[0] & 0xff) == 0xfe && (p[1] & 0xc0) == 0x80) return true;
            if ((p[0] & 0xff) == 0xff) return true;
            return false;
        }
        static byte[] canonical(InetAddress ia) {
            byte[] raw = ia.getAddress();
            if (raw.length == 16) return raw;
            byte[] out = new byte[16];
            out[10] = (byte) 0xff; out[11] = (byte) 0xff;
            System.arraycopy(raw, 0, out, 12, 4);
            return out;
        }
        static List<Cidr> parseCidrs(List<String> items) {
            List<Cidr> out = new ArrayList<>();
            if (items == null) return out;
            for (String it : items) {
                if (it == null) continue;
                String s = it.trim();
                if (s.isEmpty()) continue;
                try { out.add(new Cidr(s)); }
                catch (Exception e) { logWarn("CIDR không hợp lệ, bỏ qua: " + s); }
            }
            return out;
        }
        static boolean ipInNets(String ipStr, List<Cidr> nets) {
            try {
                InetAddress ia = InetAddress.getByName(ipStr);
                byte[] canon = canonical(ia);
                for (Cidr c : nets) if (c.contains(canon)) return true;
            } catch (Exception ignored) {}
            return false;
        }
    }

