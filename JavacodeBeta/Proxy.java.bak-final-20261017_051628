    // DASHBOARD HTTP
    // ═══════════════════════════════════════════════════════════════════════
    static class DashCtx {
        String actor = "unknown";
        String method = "GET";
    }

    static class HttpUtil {
        static String readBody(HttpExchange ex, int max) throws IOException {
            int clen = 0;
            try {
                String s = ex.getRequestHeaders().getFirst("Content-Length");
                if (s != null) clen = Integer.parseInt(s);
            } catch (Exception ignored) {}
            if (clen > max) throw new IOException("body too large");
            if (clen <= 0) return "";
            byte[] buf = ex.getRequestBody().readNBytes(clen);
            return new String(buf, StandardCharsets.UTF_8);
        }

        static void send(HttpExchange ex, int code, String ctype, byte[] body, Map<String,String> extra) throws IOException {
            ex.getResponseHeaders().set("Content-Type", ctype);
            ex.getResponseHeaders().set("Cache-Control", "no-store");
            ex.getResponseHeaders().set("Connection", "close");
            ex.getResponseHeaders().set("X-Content-Type-Options", "nosniff");
            if (extra != null) for (Map.Entry<String,String> e : extra.entrySet())
                ex.getResponseHeaders().set(e.getKey(), e.getValue());
            ex.sendResponseHeaders(code, body.length == 0 ? -1 : body.length);
            if (body.length > 0) {
                try (OutputStream os = ex.getResponseBody()) { os.write(body); }
            } else {
                ex.close();
            }
        }

        static void sendJson(HttpExchange ex, int code, Object obj) throws IOException {
            send(ex, code, "application/json", Json.stringify(obj).getBytes(StandardCharsets.UTF_8), null);
        }

        static void sendText(HttpExchange ex, int code, String s) throws IOException {
            send(ex, code, "text/plain", s.getBytes(StandardCharsets.UTF_8), null);
        }

        static void sendErr(HttpExchange ex, int code, String msg) throws IOException {
            Map<String,Object> m = new LinkedHashMap<>();
            m.put("error", msg);
            sendJson(ex, code, m);
        }

        static String peerIp(HttpExchange ex) {
            InetSocketAddress a = ex.getRemoteAddress();
            return a == null ? "" : normalizeIp(a.getAddress().getHostAddress());
        }

        static boolean csrfOk(String method, Map<String,List<String>> hdrs, String hostHdr) {
            if (method.equals("GET") || method.equals("HEAD") || method.equals("OPTIONS")) return true;
            List<String> sfs = hdrs.get("Sec-Fetch-Site");
            if (sfs != null && !sfs.isEmpty()) {
                String v = sfs.get(0);
                if (!v.equals("same-origin") && !v.equals("none")) return false;
            }
            List<String> origin = hdrs.get("Origin");
            if (origin != null && !origin.isEmpty() && hostHdr != null) {
                try {
                    URI u = new URI(origin.get(0));
                    String host = hostHdr.contains(":") ? hostHdr.substring(0, hostHdr.indexOf(":")) : hostHdr;
                    if (u.getHost() != null && !u.getHost().equals(host)) return false;
                } catch (Exception e) { return false; }
            }
            List<String> ct = hdrs.get("Content-Type");
            return ct != null && !ct.isEmpty() && ct.get(0).toLowerCase().startsWith("application/json");
        }

        static String checkToken(String token) {
            if (token == null || token.isEmpty()) return null;
            String h = sha256Hex(token);
            for (ApiToken t : CFG.apiTokens) {
                if (ctEqual(t.tokenHash, h)) return t.name;
            }
            return null;
        }

        static String checkBasic(String authz) {
            if (authz == null || !authz.toLowerCase().startsWith("basic ")) return null;
            try {
                String dec = new String(Base64.getDecoder().decode(authz.substring(6).trim()),
                                         StandardCharsets.UTF_8);
                int idx = dec.indexOf(':');
                if (idx < 0) return null;
                String u = dec.substring(0, idx);
                String p = dec.substring(idx + 1);
                AppConfig c = CFG;
                if (ctEqual(u, c.dashboardUser) && verifyPasswordCached(p, c.dashboardPasswordHash)) {
                    return "dashboard:" + u;
                }
                return null;
            } catch (Exception e) { return null; }
        }
    }

    static String dashAuth(HttpExchange ex, Map<String,List<String>> hdrs) throws IOException {
        String ip = HttpUtil.peerIp(ex);
        if (isAuthBlocked(ip)) {
            HttpUtil.sendText(ex, 429, "Too Many Requests");
            return null;
        }
        List<String> authz = hdrs.get("Authorization");
        String a = authz == null || authz.isEmpty() ? "" : authz.get(0);
        if (a.startsWith("Bearer ")) {
            String name = HttpUtil.checkToken(a.substring(7));
            if (name != null) {
                resetAuthFail(ip);
                return "token:" + name;
            }
            recordAuthFail(ip, DASH_AUTH_FAIL_THRESHOLD);
            HttpUtil.sendText(ex, 401, "Unauthorized (invalid token)");
            return null;
        }
        String actor = HttpUtil.checkBasic(a);
        if (actor == null) {
            recordAuthFail(ip, DASH_AUTH_FAIL_THRESHOLD);
            Map<String,String> extra = new HashMap<>();
            extra.put("WWW-Authenticate", "Basic realm=\"Dashboard\"");
            HttpUtil.send(ex, 401, "text/plain", "Unauthorized".getBytes(StandardCharsets.UTF_8), extra);
            return null;
        }
        resetAuthFail(ip);
        return actor;
    }

