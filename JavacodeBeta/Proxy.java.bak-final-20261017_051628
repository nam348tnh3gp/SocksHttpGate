    // PASSWORD HASH (tương thích Python/Go/Ruby/C)
    // ═══════════════════════════════════════════════════════════════════════
    static byte[] pwDigest(String password, byte[] salt, int iterations) throws Exception {
        MessageDigest md = MessageDigest.getInstance("SHA-256");
        md.update(salt);
        md.update(password.getBytes(StandardCharsets.UTF_8));
        byte[] d = md.digest();
        for (int i = 1; i < iterations; i++) d = md.digest(d);
        return d;
    }

    static String hashPassword(String password) {
        try {
            byte[] salt = new byte[16];
            new SecureRandom().nextBytes(salt);
            byte[] dg = pwDigest(password, salt, HASH_ITERS);
            return HASH_ITERS + ":" + hex(salt) + ":" + hex(dg);
        } catch (Exception e) { throw new RuntimeException(e); }
    }

    static boolean verifyPassword(String password, String stored) {
        try {
            String[] parts = stored.split(":");
            if (parts.length != 3) return false;
            int iters = Integer.parseInt(parts[0]);
            if (iters <= 0 || iters > 5_000_000) return false;
            byte[] salt = fromHex(parts[1]);
            byte[] want = fromHex(parts[2]);
            if (want.length != 32) return false;
            byte[] got = pwDigest(password, salt, iters);
            return MessageDigest.isEqual(got, want);
        } catch (Exception e) { return false; }
    }

    static final ConcurrentHashMap<String, Long> PW_CACHE = new ConcurrentHashMap<>();
    static final long PW_CACHE_TTL_MS = 300_000;
    static final Object PW_COMPUTE_LOCK = new Object();

    static boolean verifyPasswordCached(String password, String stored) {
        String key = sha256Hex(stored + "\u0000" + password);
        long now = System.currentTimeMillis();
        Long exp = PW_CACHE.get(key);
        if (exp != null && exp > now) return true;
        synchronized (PW_COMPUTE_LOCK) {
            exp = PW_CACHE.get(key);
            if (exp != null && exp > System.currentTimeMillis()) return true;
            if (!verifyPassword(password, stored)) return false;
            if (PW_CACHE.size() >= 1024) {
                long now2 = System.currentTimeMillis();
                PW_CACHE.entrySet().removeIf(e -> e.getValue() <= now2);
                if (PW_CACHE.size() >= 1024) PW_CACHE.clear();
            }
            PW_CACHE.put(key, System.currentTimeMillis() + PW_CACHE_TTL_MS);
            return true;
        }
    }

