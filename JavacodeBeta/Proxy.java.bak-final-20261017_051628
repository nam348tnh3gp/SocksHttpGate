    static String normalizeIp(String ip) {
        if (ip == null) return "";
        if (ip.startsWith("/")) ip = ip.substring(1);
        if (ip.startsWith("::ffff:")) return ip.substring(7);
        return ip;
    }

    static String formatBytes(long b) {
        if (b < 1024) return String.format("%.1f B", (double) b);
        String[] units = {"B", "KiB", "MiB", "GiB", "TiB", "PiB"};
        double v = b;
        int i = 0;
        while (v >= 1024 && i < units.length - 1) { v /= 1024; i++; }
        return String.format("%.1f %s", v, units[i]);
    }

    static String formatDuration(double seconds) {
        long s = (long) seconds;
        long h = s / 3600, m = (s % 3600) / 60, x = s % 60;
        return String.format("%02d:%02d:%02d", h, m, x);
    }

    static boolean ctEqual(String a, String b) {
        if (a == null || b == null) return a == b;
        byte[] x = a.getBytes(StandardCharsets.UTF_8);
        byte[] y = b.getBytes(StandardCharsets.UTF_8);
        return MessageDigest.isEqual(x, y);
    }

    static String hex(byte[] b) {
        StringBuilder sb = new StringBuilder(b.length * 2);
        for (byte x : b) sb.append(String.format("%02x", x & 0xff));
        return sb.toString();
    }

    static byte[] fromHex(String s) {
        int n = s.length() / 2;
        byte[] out = new byte[n];
        for (int i = 0; i < n; i++) out[i] = (byte) Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);
        return out;
    }

    static String sha256Hex(String s) {
        try {
            MessageDigest md = MessageDigest.getInstance("SHA-256");
            return hex(md.digest(s.getBytes(StandardCharsets.UTF_8)));
        } catch (Exception e) { throw new RuntimeException(e); }
    }

    static String randomTokenHex(int nbytes) {
