    static void saveConfigLocked(String path, AppConfig cfg) throws IOException {
        String json = Json.stringify(cfg.toMap());
        File tmp = new File(path + ".tmp");
        try (FileWriter fw = new FileWriter(tmp)) { fw.write(json); }
        tmp.setReadable(false, false);
        tmp.setReadable(true, true);
        tmp.setWritable(false, false);
        tmp.setWritable(true, true);
        File target = new File(path);
        if (!tmp.renameTo(target)) {
            // fallback
            Files_move(tmp.toPath(), target.toPath());
        }
    }

    static void Files_move(java.nio.file.Path src, java.nio.file.Path dst) throws IOException {
        try {
            java.nio.file.Files.move(src, dst,
                java.nio.file.StandardCopyOption.REPLACE_EXISTING,
                java.nio.file.StandardCopyOption.ATOMIC_MOVE);
        } catch (Exception e) {
            java.nio.file.Files.move(src, dst, java.nio.file.StandardCopyOption.REPLACE_EXISTING);
        }
    }

    static boolean loadOrInitConfig(String path, String fbUser, String fbPass) {
        File f = new File(path);
        if (f.exists()) {
            try {
                String text = new String(java.nio.file.Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8);
                @SuppressWarnings("unchecked")
                Map<String,Object> m = (Map<String,Object>) Json.parse(text);
                AppConfig c = AppConfig.fromMap(m);
                if (c.dashboardUser.isEmpty() || c.dashboardPasswordHash.isEmpty()) {
                    logErr("config file thiếu dashboard_user/dashboard_password_hash");
                    return false;
                }
                CFG = c;
                return false;
            } catch (Exception e) {
                logErr("config file " + path + " không hợp lệ: " + e.getMessage());
                return false;
            }
        }
        AppConfig c = new AppConfig();
        c.dashboardUser = fbUser;
        c.dashboardPasswordHash = hashPassword(fbPass);
        CFG = c;
        try {
            synchronized (CFG_LOCK) { saveConfigLocked(path, c); }
            log("Đã tạo config file mới tại " + path);
        } catch (Exception e) {
            logWarn("Không ghi được config: " + e.getMessage());
        }
        return true;
    }

    static boolean reloadConfig(String source) {
        ReloadEvent ev = new ReloadEvent();
        ev.t = System.currentTimeMillis() / 1000;
        ev.source = source;
        try {
            File f = new File(CONFIG_PATH);
            if (!f.exists()) throw new IOException("file không tồn tại");
            String text = new String(java.nio.file.Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8);
            @SuppressWarnings("unchecked")
            Map<String,Object> m = (Map<String,Object>) Json.parse(text);
            AppConfig nc = AppConfig.fromMap(m);
            if (nc.dashboardUser.isEmpty() || nc.dashboardPasswordHash.isEmpty()) {
                throw new IOException("thiếu dashboard_user/dashboard_password_hash");
            }
            List<Cidr> na = Ssrf.parseCidrs(nc.allowList);
            List<Cidr> nd = Ssrf.parseCidrs(nc.denyList);
            ALLOWED_CIDRS = na;
            DENIED_CIDRS = nd;

            List<String[]> newUp = new ArrayList<>();
            for (String it : nc.upstreamProxies) {
                if (it == null) continue;
                int idx = it.lastIndexOf(':');
                if (idx < 0) continue;
                try {
                    newUp.add(new String[]{it.substring(0, idx), it.substring(idx + 1)});
                } catch (Exception ignored) {}
            }
            synchronized (UPSTREAM_LOCK) {
                UPSTREAM_PROXIES = newUp;
                if (UPSTREAM_IDX.get() >= newUp.size()) UPSTREAM_IDX.set(0);
            }

            synchronized (CFG_LOCK) { CFG = nc; }

            for (ConnectionInfo c : ACTIVE_CONNS.values()) {
                for (ProxyUser u : nc.users) {
                    if (u.username.equals(c.username)) { c.rateBps = u.maxBandwidthBps; break; }
                }
            }

            ev.success = true;
            ev.allowCount = na.size();
            ev.denyCount = nd.size();
            ev.upstreamCount = newUp.size();
            ev.userCount = nc.users.size();
            recordReload(ev);
            log("Đã reload config (" + source + "): " + ev.allowCount + " allow, " +
                ev.denyCount + " deny, " + ev.upstreamCount + " upstream, " + ev.userCount + " user");
            return true;
        } catch (Exception e) {
            ev.error = e.getMessage();
            recordReload(ev);
            logErr("Reload config thất bại: " + e.getMessage());
            return false;
        }
    }

    static void usageLoad(String path) {
        try {
            File f = new File(path);
            if (!f.exists()) return;
            String text = new String(java.nio.file.Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8);
            @SuppressWarnings("unchecked")
            Map<String,Object> m = (Map<String,Object>) Json.parse(text);
            for (Map.Entry<String,Object> e : m.entrySet()) {
                @SuppressWarnings("unchecked")
                Map<String,Object> r = (Map<String,Object>) e.getValue();
                USAGE.put(e.getKey(), r);
            }
        } catch (Exception e) {
            logWarn("Usage file lỗi, bỏ qua: " + e.getMessage());
        }
    }

    static void usageSave(String path) {
        if (path == null || path.isEmpty()) return;
        try {
            Map<String,Object> snap = new LinkedHashMap<>();
            for (Map.Entry<String,Map<String,Object>> e : USAGE.entrySet()) snap.put(e.getKey(), e.getValue());
            String json = Json.stringify(snap);
            File tmp = new File(path + ".tmp");
            try (FileWriter fw = new FileWriter(tmp)) { fw.write(json); }
            Files_move(tmp.toPath(), new File(path).toPath());
        } catch (Exception e) {
            logWarn("Không lưu được usage: " + e.getMessage());
        }
    }

