                       String target, long rateBps, String username, Socket conn) {
            this.id = id; this.ip = ip; this.port = port;
            this.type = type; this.target = target;
            this.rateBps = rateBps; this.username = username;
            this.conn = conn;
            this.startMs = System.currentTimeMillis();
        }
    }
