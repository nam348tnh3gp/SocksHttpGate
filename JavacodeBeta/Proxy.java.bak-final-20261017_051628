    static HttpServer dashServer;

    static void startDashboard(String bind, int port) throws IOException {
        dashServer = HttpServer.create(new InetSocketAddress(bind, port), 0);
        dashServer.setExecutor(Executors.newVirtualThreadPerTaskExecutor());

        dashServer.createContext("/healthz", ex -> {
            try {
                if (SHUTDOWN) HttpUtil.sendJson(ex, 503, Map.of("status", "shutting_down"));
                else HttpUtil.sendJson(ex, 200, Map.of("status", "ok"));
            } catch (Exception ignored) {}
        });

        dashServer.createContext("/metrics", ex -> {
            try {
                StringBuilder sb = new StringBuilder();
                long up = (System.currentTimeMillis() - STATS.startMs) / 1000;
                metric(sb, "connections_total", "counter", STATS.total.get());
                metric(sb, "connections_current", "gauge", STATS.current.get());
                metric(sb, "connections_active", "gauge", ACTIVE_CONNS.size());
                metric(sb, "socks5_tcp_total", "counter", STATS.socks5Tcp.get());
                metric(sb, "socks5_udp_total", "counter", STATS.socks5Udp.get());
                metric(sb, "http_requests_total", "counter", STATS.http.get());
                metric(sb, "bytes_up_total", "counter", STATS.bytesUp.get());
                metric(sb, "bytes_down_total", "counter", STATS.bytesDown.get());
                metric(sb, "udp_bytes_up_total", "counter", STATS.udpUp.get());
                metric(sb, "udp_bytes_down_total", "counter", STATS.udpDown.get());
                metric(sb, "udp_associations", "gauge", STATS.udpAssocs.get());
                metric(sb, "auth_fail_total", "counter", STATS.authFail.get());
                metric(sb, "uptime_seconds", "gauge", up);
                HttpUtil.send(ex, 200, "text/plain; version=0.0.4",
                    sb.toString().getBytes(StandardCharsets.UTF_8), null);
            } catch (Exception ignored) {}
        });

        dashServer.createContext("/", Proxy::handleDash);
        dashServer.start();
        log(CYAN + "Dashboard: http://" + bind + ":" + port + RESET);
    }

    static void metric(StringBuilder sb, String name, String type, Object val) {
        sb.append("# TYPE proxy_").append(name).append(' ').append(type).append('\n');
        sb.append("proxy_").append(name).append(' ').append(val).append('\n');
    }

    @SuppressWarnings("unchecked")
    static void handleDash(HttpExchange ex) throws IOException {
        String path = ex.getRequestURI().getPath();
        String method = ex.getRequestMethod();
        String peer = HttpUtil.peerIp(ex);

        Map<String,List<String>> hdrs = new LinkedHashMap<>();
        for (Map.Entry<String,List<String>> e : ex.getRequestHeaders().entrySet()) {
            hdrs.put(e.getKey().toLowerCase(), e.getValue());
        }

        try {
            // Auth
            String actor = dashAuth(ex, hdrs);
            if (actor == null) return;

            // CSRF
            if (!HttpUtil.csrfOk(method, hdrs, ex.getRequestHeaders().getFirst("Host"))) {
                HttpUtil.sendText(ex, 403, "Forbidden (CSRF)");
                return;
            }

            // Route
            if (method.equals("GET") && path.equals("/")) {
                HttpUtil.send(ex, 200, "text/html; charset=utf-8",
                    DASH_HTML.getBytes(StandardCharsets.UTF_8), null);
                return;
            }
            if (method.equals("GET") && path.equals("/stats")) {
                HttpUtil.sendJson(ex, 200, statsBasic()); return;
            }
            if (method.equals("GET") && path.equals("/api/all")) {
                HttpUtil.sendJson(ex, 200, statsAll()); return;
            }
            if (method.equals("GET") && path.equals("/api/stream")) {
                handleStream(ex); return;
            }
            if (method.equals("GET") && path.equals("/api/audit-log")) {
                List<Object> ev = new ArrayList<>();
                synchronized (AUDIT_LOCK) {
                    Iterator<AuditEvent> it = AUDIT_LOG.descendingIterator();
                    while (it.hasNext()) ev.add(it.next().toMap());
                }
                Map<String,Object> m = new LinkedHashMap<>();
                m.put("events", ev); HttpUtil.sendJson(ex, 200, m); return;
            }
            if (method.equals("GET") && path.equals("/api/reload-history")) {
                List<Object> hist = new ArrayList<>();
                synchronized (RELOAD_LOCK) {
                    Iterator<ReloadEvent> it = RELOAD_HIST.descendingIterator();
                    while (it.hasNext()) hist.add(it.next().toMap());
                }
                Map<String,Object> m = new LinkedHashMap<>();
                m.put("history", hist); HttpUtil.sendJson(ex, 200, m); return;
            }
            if (method.equals("GET") && path.equals("/api/users")) {
                List<Object> us = new ArrayList<>();
                for (ProxyUser u : CFG.users) {
                    Map<String,Object> um = new LinkedHashMap<>();
                    um.put("username", u.username);
                    um.put("max_bandwidth_bps", u.maxBandwidthBps);
                    um.put("max_connections", u.maxConnections);
                    um.put("quota_bytes_per_month", u.quotaBytesPerMonth);
                    um.put("usage_bytes_this_month", usageGet(u.username));
                    us.add(um);
                }
                Map<String,Object> m = new LinkedHashMap<>();
                m.put("users", us); HttpUtil.sendJson(ex, 200, m); return;
            }
            if (method.equals("GET") && path.equals("/api/tokens")) {
                List<Object> ts = new ArrayList<>();
                for (ApiToken t : CFG.apiTokens) {
                    Map<String,Object> tm = new LinkedHashMap<>();
                    tm.put("name", t.name); tm.put("created_at", t.createdAt);
                    ts.add(tm);
                }
                Map<String,Object> m = new LinkedHashMap<>();
                m.put("tokens", ts); HttpUtil.sendJson(ex, 200, m); return;
            }
            if (method.equals("GET") && path.equals("/api/network-config")) {
                Map<String,Object> m = new LinkedHashMap<>();
                m.put("allow_list", new ArrayList<Object>(CFG.allowList));
                m.put("deny_list", new ArrayList<Object>(CFG.denyList));
                m.put("upstream_proxies", new ArrayList<Object>(CFG.upstreamProxies));
                HttpUtil.sendJson(ex, 200, m); return;
            }
            if (method.equals("GET") && path.equals("/api/export")) {
                String fmt = "json";
                String q = ex.getRequestURI().getQuery();
                if (q != null && q.contains("format=csv")) fmt = "csv";
                List<Map<String,Object>> rows = new ArrayList<>();
                long now = System.currentTimeMillis();
                for (ConnectionInfo c : ACTIVE_CONNS.values()) {
                    Map<String,Object> cm = new LinkedHashMap<>();
                    cm.put("id", c.id); cm.put("ip", c.ip); cm.put("port", c.port);
                    cm.put("type", c.type); cm.put("target", c.target); cm.put("user", c.username);
                    cm.put("bytes_up", c.bytesUp.get());
                    cm.put("bytes_down", c.bytesDown.get());
                    cm.put("duration", (now - c.startMs) / 1000.0);
                    rows.add(cm);
                }
                if (fmt.equals("csv")) {
                    StringBuilder sb = new StringBuilder("id,ip,port,type,target,user,bytes_up,bytes_down,duration\n");
                    for (Map<String,Object> r : rows) {
                        sb.append(csvField(String.valueOf(r.get("id")))).append(',')
                          .append(csvField(String.valueOf(r.get("ip")))).append(',')
                          .append(r.get("port")).append(',')
                          .append(csvField(String.valueOf(r.get("type")))).append(',')
                          .append(csvField(String.valueOf(r.get("target")))).append(',')
                          .append(csvField(String.valueOf(r.get("user")))).append(',')
                          .append(r.get("bytes_up")).append(',')
                          .append(r.get("bytes_down")).append(',')
                          .append(String.format("%.1f", (Double) r.get("duration"))).append('\n');
                    }
                    Map<String,String> extra = new HashMap<>();
                    extra.put("Content-Disposition", "attachment; filename=connections.csv");
                    HttpUtil.send(ex, 200, "text/csv",
                        sb.toString().getBytes(StandardCharsets.UTF_8), extra);
                } else {
                    Map<String,String> extra = new HashMap<>();
                    extra.put("Content-Disposition", "attachment; filename=connections.json");
                    HttpUtil.send(ex, 200, "application/json",
                        Json.stringify(rows).getBytes(StandardCharsets.UTF_8), extra);
                }
                return;
            }
            if (method.equals("GET") && path.equals("/api/config/export")) {
                recordAudit(actor, "export_config_backup", "");
                String fn = "proxy_config_backup_" +
                    ZonedDateTime.now().toLocalDateTime().toString().replace(":", "").replace(".", "") + ".json";
                Map<String,String> extra = new HashMap<>();
                extra.put("Content-Disposition", "attachment; filename=" + fn);
                HttpUtil.send(ex, 200, "application/json",
                    Json.stringify(CFG.toMap()).getBytes(StandardCharsets.UTF_8), extra);
                return;
            }

            // POST
            if (method.equals("POST") && path.equals("/api/kick")) {
                String body = HttpUtil.readBody(ex, 2048);
                @SuppressWarnings("unchecked")
                Map<String,Object> j = (Map<String,Object>) Json.parse(body);
                String id = Json.s(j, "id");
                if (id == null) { HttpUtil.sendErr(ex, 400, "Missing 'id'"); return; }
                ConnectionInfo c = ACTIVE_CONNS.get(id);
                if (c == null) { HttpUtil.sendErr(ex, 404, "Connection not found"); return; }
                try { if (c.conn != null) c.conn.close(); } catch (Exception ignored) {}
                Map<String,Object> out = new LinkedHashMap<>();
                out.put("success", true); out.put("id", id);
                HttpUtil.sendJson(ex, 200, out);
                recordAudit(actor, "kick_connection", "id=" + id);
                return;
            }

            if (method.equals("POST") && path.equals("/api/users")) {
                String body = HttpUtil.readBody(ex, 4096);
                @SuppressWarnings("unchecked")
                Map<String,Object> j = (Map<String,Object>) Json.parse(body);
                String uname = Json.s(j, "username");
                if (uname == null || uname.trim().isEmpty()) { HttpUtil.sendErr(ex, 400, "Username required"); return; }
                uname = uname.trim();
                if (uname.length() >= 64) { HttpUtil.sendErr(ex, 400, "Username too long"); return; }
                String pwd = Json.s(j, "password");
                if (pwd == null) pwd = "";
                if (!pwd.isEmpty() && pwd.length() < 4) { HttpUtil.sendErr(ex, 400, "Password must be >= 4 chars"); return; }
                long bw = Json.l(j, "max_bandwidth_bps", 0);
                long mc = Json.l(j, "max_connections", 0);
                long q = Json.l(j, "quota_bytes_per_month", 0);
                bw = Math.max(0, bw); mc = Math.max(0, mc); q = Math.max(0, q);
                String pwdHash = pwd.isEmpty() ? null : hashPassword(pwd);

                synchronized (CFG_LOCK) {
                    int idx = -1;
                    for (int i = 0; i < CFG.users.size(); i++) if (CFG.users.get(i).username.equals(uname)) { idx = i; break; }
                    if (idx >= 0) {
                        ProxyUser u = CFG.users.get(idx);
                        if (pwdHash != null) u.passwordHash = pwdHash;
                        u.maxBandwidthBps = bw; u.maxConnections = mc; u.quotaBytesPerMonth = q;
                    } else {
                        if (pwdHash == null) { HttpUtil.sendErr(ex, 400, "Password required for new user"); return; }
                        ProxyUser u = new ProxyUser();
                        u.username = uname; u.passwordHash = pwdHash;
                        u.maxBandwidthBps = bw; u.maxConnections = mc; u.quotaBytesPerMonth = q;
                        CFG.users.add(u);
                        CFG.requireProxyAuth = true;
                    }
                    try { saveConfigLocked(CONFIG_PATH, CFG); }
                    catch (Exception e) {
                        HttpUtil.sendErr(ex, 500, "Saved in memory but write failed: " + e.getMessage());
                        return;
                    }
                }
                for (ConnectionInfo c : ACTIVE_CONNS.values())
                    if (c.username.equals(uname)) c.rateBps = bw;
                recordAudit(actor, "upsert_user", "username=" + uname + " bw=" + bw + " mc=" + mc + " q=" + q);
                HttpUtil.sendJson(ex, 200, Map.of("success", true));
                return;
            }

            if (method.equals("POST") && path.equals("/api/users/delete")) {
                String body = HttpUtil.readBody(ex, 2048);
                @SuppressWarnings("unchecked")
                Map<String,Object> j = (Map<String,Object>) Json.parse(body);
                String uname = Json.s(j, "username");
                if (uname == null) { HttpUtil.sendErr(ex, 400, "Missing 'username'"); return; }
                boolean removed = false;
                synchronized (CFG_LOCK) {
                    int before = CFG.users.size();
                    CFG.users.removeIf(u -> u.username.equals(uname));
                    removed = CFG.users.size() < before;
                    if (removed) {
                        try { saveConfigLocked(CONFIG_PATH, CFG); }
                        catch (Exception e) { HttpUtil.sendErr(ex, 500, "Write failed: " + e.getMessage()); return; }
                    }
                }
                if (!removed) { HttpUtil.sendErr(ex, 404, "User not found"); return; }
                recordAudit(actor, "delete_user", "username=" + uname);
                HttpUtil.sendJson(ex, 200, Map.of("success", true));
                return;
            }

            if (method.equals("POST") && path.equals("/api/tokens")) {
                String body = HttpUtil.readBody(ex, 2048);
                @SuppressWarnings("unchecked")
                Map<String,Object> j = (Map<String,Object>) Json.parse(body);
                String name = Json.s(j, "name");
                if (name == null || name.trim().isEmpty()) { HttpUtil.sendErr(ex, 400, "Name required"); return; }
                name = name.trim();
                if (name.length() >= 64) { HttpUtil.sendErr(ex, 400, "Name too long"); return; }
                synchronized (CFG_LOCK) {
                    for (ApiToken t : CFG.apiTokens) {
                        if (t.name.equals(name)) { HttpUtil.sendErr(ex, 409, "Token name exists"); return; }
                    }
                }
                String token = randomTokenHex(32);
                ApiToken t = new ApiToken();
                t.name = name; t.tokenHash = sha256Hex(token);
                t.createdAt = System.currentTimeMillis() / 1000;
                synchronized (CFG_LOCK) {
                    CFG.apiTokens.add(t);
                    try { saveConfigLocked(CONFIG_PATH, CFG); }
                    catch (Exception e) { HttpUtil.sendErr(ex, 500, "Write failed: " + e.getMessage()); return; }
                }
                recordAudit(actor, "create_api_token", "name=" + name);
                Map<String,Object> out = new LinkedHashMap<>();
                out.put("success", true); out.put("token", token); out.put("name", name);
                HttpUtil.sendJson(ex, 200, out);
                return;
            }

            if (method.equals("POST") && path.equals("/api/tokens/delete")) {
                String body = HttpUtil.readBody(ex, 2048);
                @SuppressWarnings("unchecked")
                Map<String,Object> j = (Map<String,Object>) Json.parse(body);
                String name = Json.s(j, "name");
                if (name == null) { HttpUtil.sendErr(ex, 400, "Missing 'name'"); return; }
                boolean removed = false;
                synchronized (CFG_LOCK) {
                    int before = CFG.apiTokens.size();
                    CFG.apiTokens.removeIf(t -> t.name.equals(name));
                    removed = CFG.apiTokens.size() < before;
                    if (removed) {
                        try { saveConfigLocked(CONFIG_PATH, CFG); }
                        catch (Exception e) { HttpUtil.sendErr(ex, 500, "Write failed: " + e.getMessage()); return; }
                    }
                }
                if (!removed) { HttpUtil.sendErr(ex, 404, "Token not found"); return; }
                recordAudit(actor, "revoke_api_token", "name=" + name);
                HttpUtil.sendJson(ex, 200, Map.of("success", true));
                return;
            }

            if (method.equals("POST") && path.equals("/api/change-password")) {
                String body = HttpUtil.readBody(ex, 4096);
                @SuppressWarnings("unchecked")
                Map<String,Object> j = (Map<String,Object>) Json.parse(body);
                String cur = Json.s(j, "current_password");
                String nu = Json.s(j, "new_username");
                String np = Json.s(j, "new_password");
                if (cur == null) cur = "";
                if (nu == null) nu = "";
                if (np == null) np = "";
                AppConfig c = CFG;
                if (!verifyPassword(cur, c.dashboardPasswordHash)) {
                    HttpUtil.sendErr(ex, 403, "Current password incorrect"); return;
                }
                if (np.length() < 8) { HttpUtil.sendErr(ex, 400, "New password must be >= 8"); return; }
                if (np.equals(cur)) { HttpUtil.sendErr(ex, 400, "New password must differ"); return; }
                String newHash = hashPassword(np);
                synchronized (CFG_LOCK) {
                    if (!nu.isEmpty()) CFG.dashboardUser = nu;
                    CFG.dashboardPasswordHash = newHash;
                    try { saveConfigLocked(CONFIG_PATH, CFG); }
                    catch (Exception e) { logWarn("Đổi mật khẩu OK nhưng ghi file lỗi: " + e.getMessage()); }
                }
                recordAudit(actor, "change_dashboard_password", "user: " + c.dashboardUser + " -> " + CFG.dashboardUser);
                Map<String,Object> out = new LinkedHashMap<>();
                out.put("success", true); out.put("username", CFG.dashboardUser);
                HttpUtil.sendJson(ex, 200, out);
                return;
            }

            if (method.equals("POST") && path.equals("/api/reload")) {
                boolean ok = reloadConfig(actor);
                if (!ok) { HttpUtil.sendErr(ex, 400, "reload failed"); return; }
                recordAudit(actor, "reload_config", "success");
                HttpUtil.sendJson(ex, 200, Map.of("success", true));
                return;
            }

            if (method.equals("POST") && path.equals("/api/network-config")) {
                String body = HttpUtil.readBody(ex, 65536);
                @SuppressWarnings("unchecked")
                Map<String,Object> j = (Map<String,Object>) Json.parse(body);
                List<String> allow = toStringList(Json.arr(j, "allow_list"));
                List<String> deny = toStringList(Json.arr(j, "deny_list"));
                List<String> ups = toStringList(Json.arr(j, "upstream_proxies"));
                synchronized (CFG_LOCK) {
                    CFG.allowList = allow;
                    CFG.denyList = deny;
                    CFG.upstreamProxies = ups;
                    try { saveConfigLocked(CONFIG_PATH, CFG); }
                    catch (Exception e) { HttpUtil.sendErr(ex, 500, "Write failed: " + e.getMessage()); return; }
                }
                if (!reloadConfig(actor)) {
                    HttpUtil.sendErr(ex, 500, "Saved but reload failed");
                    return;
                }
                recordAudit(actor, "update_network_config", allow.size() + " allow, " + deny.size() + " deny, " + ups.size() + " upstream");
                HttpUtil.sendJson(ex, 200, Map.of("success", true));
                return;
            }

            if (method.equals("POST") && path.equals("/api/config/import")) {
                String body = HttpUtil.readBody(ex, 5 * 1024 * 1024);
                @SuppressWarnings("unchecked")
                Map<String,Object> j = (Map<String,Object>) Json.parse(body);
                if (j.get("dashboard_user") == null || j.get("dashboard_password_hash") == null) {
                    HttpUtil.sendErr(ex, 400, "Not a valid backup file"); return;
                }
                AppConfig nc = AppConfig.fromMap(j);
                try { saveConfigLocked(CONFIG_PATH, nc); }
                catch (Exception e) { HttpUtil.sendErr(ex, 500, "Write failed: " + e.getMessage()); return; }
                if (!reloadConfig(actor)) {
                    HttpUtil.sendErr(ex, 500, "Imported but reload failed");
                    return;
                }
                recordAudit(actor, "import_config_backup", nc.users.size() + " users, " + nc.apiTokens.size() + " tokens");
                HttpUtil.sendJson(ex, 200, Map.of("success", true));
                return;
            }

            HttpUtil.sendText(ex, 404, "404 Not Found");
        } catch (Exception e) {
            try { HttpUtil.sendErr(ex, 500, e.getMessage()); } catch (Exception ignored) {}
        }
    }

    static List<String> toStringList(List<Object> l) {
        List<String> out = new ArrayList<>();
        if (l == null) return out;
        for (Object o : l) if (o instanceof String) out.add((String) o);
        return out;
    }

    static String csvField(String s) {
        if (s.contains(",") || s.contains("\"") || s.contains("\n") || s.contains("\r")) {
            return "\"" + s.replace("\"", "\"\"") + "\"";
        }
        return s;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // SSE STREAM
    // ═══════════════════════════════════════════════════════════════════════
    static void handleStream(HttpExchange ex) throws IOException {
        if (SSE_CLIENTS.size() >= DASH_MAX_SSE) {
            HttpUtil.sendErr(ex, 503, "Too many streaming clients");
            return;
        }
        ex.getResponseHeaders().set("Content-Type", "text/event-stream");
        ex.getResponseHeaders().set("Cache-Control", "no-cache");
        ex.getResponseHeaders().set("Connection", "close");
        ex.getResponseHeaders().set("X-Content-Type-Options", "nosniff");
        ex.getResponseHeaders().set("X-Accel-Buffering", "no");
        ex.sendResponseHeaders(200, 0);

        OutputStream os = ex.getResponseBody();
        BlockingQueue<Map<String,Object>> q = new LinkedBlockingQueue<>(8);
        SSE_CLIENTS.add(q);

        try {
            // Send history
            List<Object> hist = new ArrayList<>();
            synchronized (HIST_LOCK) { hist.addAll(SAMPLE_HIST); }
            os.write(("event: history\ndata: " + Json.stringify(hist) + "\n\n").getBytes(StandardCharsets.UTF_8));
            os.flush();

            long lastKeepalive = System.currentTimeMillis();
            while (!SHUTDOWN) {
                Map<String,Object> sample = q.poll(1, TimeUnit.SECONDS);
                if (sample != null) {
                    os.write(("event: sample\ndata: " + Json.stringify(sample) + "\n\n").getBytes(StandardCharsets.UTF_8));
                    os.flush();
                    lastKeepalive = System.currentTimeMillis();
                } else if (System.currentTimeMillis() - lastKeepalive >= 15000) {
                    os.write(": keepalive\n\n".getBytes(StandardCharsets.UTF_8));
                    os.flush();
                    lastKeepalive = System.currentTimeMillis();
                }
            }
        } catch (Exception ignored) {
        } finally {
            SSE_CLIENTS.remove(q);
            try { os.close(); } catch (Exception ignored) {}
        }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // BACKGROUND THREADS
    // ═══════════════════════════════════════════════════════════════════════
    static void startBackgroundThreads() {
        // SSE sampler
        Thread.ofVirtual().start(() -> {
            long lastUp = 0, lastDown = 0;
            boolean first = true;
            long interval = 2000;
            while (!SHUTDOWN) {
                try { Thread.sleep(interval); } catch (InterruptedException e) { break; }
                if (SHUTDOWN) break;
                long up = STATS.bytesUp.get();
                long down = STATS.bytesDown.get();
                long upBps = first ? 0 : (up - lastUp) * 1000 / interval;
                long downBps = first ? 0 : (down - lastDown) * 1000 / interval;
                lastUp = up; lastDown = down; first = false;

                Map<String,Object> sample = new LinkedHashMap<>();
                sample.put("t", System.currentTimeMillis() / 1000);
                sample.put("up_bps", upBps);
                sample.put("down_bps", downBps);
                sample.put("active", ACTIVE_CONNS.size());
                sample.put("udp_assocs", UDP_ASSOCS.size());

                synchronized (HIST_LOCK) {
                    SAMPLE_HIST.addLast(sample);
                    while (SAMPLE_HIST.size() > HIST_MAX) SAMPLE_HIST.removeFirst();
                }
                for (BlockingQueue<Map<String,Object>> q : SSE_CLIENTS) {
                    try { q.offer(sample); } catch (Exception ignored) {}
                }
            }
        });

        // Upstream health checker
        Thread.ofVirtual().start(() -> {
            while (!SHUTDOWN) {
                try { Thread.sleep(15000); } catch (InterruptedException e) { break; }
                if (SHUTDOWN) break;
                for (String[] u : UPSTREAM_PROXIES) {
                    String key = u[0] + ":" + u[1];
                    try {
                        Socket s = tryConnect(u[0], Integer.parseInt(u[1]), 3000);
                        if (s != null) { s.close(); UPSTREAM_HEALTH.put(key, true); }
                        else UPSTREAM_HEALTH.put(key, false);
                    } catch (Exception e) { UPSTREAM_HEALTH.put(key, false); }
                }
            }
        });

        // Quota enforcer
        Thread.ofVirtual().start(() -> {
            while (!SHUTDOWN) {
                try { Thread.sleep(10000); } catch (InterruptedException e) { break; }
                if (SHUTDOWN) break;
                Map<String, Long> quotas = new HashMap<>();
                for (ProxyUser u : CFG.users) quotas.put(u.username, u.quotaBytesPerMonth);
                for (Map.Entry<String, Long> e : quotas.entrySet()) {
                    String uname = e.getKey();
                    long q = e.getValue();
                    if (q <= 0 || usageGet(uname) < q) continue;
                    List<ConnectionInfo> victims = new ArrayList<>();
                    for (ConnectionInfo c : ACTIVE_CONNS.values())
                        if (uname.equals(c.username)) victims.add(c);
                    for (ConnectionInfo c : victims) {
                        try { if (c.conn != null) c.conn.close(); } catch (Exception ignored) {}
                    }
                    if (!victims.isEmpty())
                        logWarn("Ngắt " + victims.size() + " conn của user " + uname + " do vượt quota");
                }
            }
        });

        // Usage saver
        Thread.ofVirtual().start(() -> {
            while (!SHUTDOWN) {
                try { Thread.sleep(30000); } catch (InterruptedException e) { break; }
                if (SHUTDOWN) break;
                usageSave(USAGE_PATH);
            }
        });
    }

    // ═══════════════════════════════════════════════════════════════════════
    // MAIN
    // ═══════════════════════════════════════════════════════════════════════
    public static void main(String[] argv) throws Exception {
        // Parse args
        String listenAddr = "0.0.0.0";
        int listenPort = 1080;
        String username = "", password = "";
        boolean noUdp = false;
        String upstreamStr = "";
        int dashPort = DASH_PORT_DEF;
        String dashBind = "0.0.0.0";
        String configPath = "proxy_config.json";
        String usagePath = "proxy_usage.json";
        String initDashUser = "admin";
        String initDashPass = "";
        String allowStr = "";
        String denyStr = "";

        for (int i = 0; i < argv.length; i++) {
            String a = argv[i];
            switch (a) {
                case "-l": case "--listen": if (i+1 < argv.length) listenAddr = argv[++i]; break;
                case "-p": case "--port":   if (i+1 < argv.length) listenPort = Integer.parseInt(argv[++i]); break;
                case "-u": case "--username": if (i+1 < argv.length) username = argv[++i]; break;
                case "-P": case "--password": if (i+1 < argv.length) password = argv[++i]; break;
                case "--no-udp": noUdp = true; break;
                case "--upstream": if (i+1 < argv.length) upstreamStr = argv[++i]; break;
                case "--dashboard-port": if (i+1 < argv.length) dashPort = Integer.parseInt(argv[++i]); break;
                case "--dashboard-bind": if (i+1 < argv.length) dashBind = argv[++i]; break;
                case "--config": if (i+1 < argv.length) configPath = argv[++i]; break;
                case "--usage-file": if (i+1 < argv.length) usagePath = argv[++i]; break;
                case "--dashboard-user": if (i+1 < argv.length) initDashUser = argv[++i]; break;
                case "--dashboard-pass": if (i+1 < argv.length) initDashPass = argv[++i]; break;
                case "--allow": if (i+1 < argv.length) allowStr = argv[++i]; break;
                case "--deny": if (i+1 < argv.length) denyStr = argv[++i]; break;
                case "-h": case "--help":
                    System.out.println("Usage: java Proxy [options]");
                    System.out.println("  -l --listen ADDR          Bind (default 0.0.0.0)");
                    System.out.println("  -p --port PORT            Proxy port (default 1080)");
                    System.out.println("  -u --username USER        Legacy auth user");
                    System.out.println("  -P --password PASS        Legacy auth pass");
                    System.out.println("     --no-udp               Disable SOCKS5 UDP");
                    System.out.println("     --upstream LIST        Upstream proxies (host:port,...)");
                    System.out.println("     --dashboard-port PORT  Dashboard port (default 8081)");
                    System.out.println("     --dashboard-bind ADDR  Dashboard bind (default 0.0.0.0)");
                    System.out.println("     --config FILE          Config file (default proxy_config.json)");
                    System.out.println("     --usage-file FILE      Usage file");
                    System.out.println("     --dashboard-user USER  First-run only");
                    System.out.println("     --dashboard-pass PASS  First-run only");
                    System.out.println("     --allow CIDRS          Whitelist (first run)");
                    System.out.println("     --deny CIDRS           Blacklist (first run)");
                    System.exit(0);
                    break;
            }
        }

        CONFIG_PATH = configPath;
        USAGE_PATH = usagePath;

        // Load config
        String initPass = initDashPass;
        String generatedPass = null;
        if (!new File(configPath).exists() && initPass.isEmpty()) {
            initPass = randomTokenHex(8);
            generatedPass = initPass;
        }
        boolean wasCreated = loadOrInitConfig(configPath,
            initDashUser.isEmpty() ? "admin" : initDashUser,
            initPass.isEmpty() ? "changeme" : initPass);

        if (wasCreated && generatedPass != null) {
            logWarn(RED + "Dashboard lần đầu — user: " + initDashUser + " | password: " + generatedPass + RESET);
            logWarn(RED + "(chỉ hiện MỘT LẦN — đổi ngay trên dashboard)" + RESET);
        }

        // Seed allow/deny/upstream on first run
        if (wasCreated) {
            synchronized (CFG_LOCK) {
                for (String s : allowStr.split(",")) { String t = s.trim(); if (!t.isEmpty()) CFG.allowList.add(t); }
                for (String s : denyStr.split(","))  { String t = s.trim(); if (!t.isEmpty()) CFG.denyList.add(t); }
                for (String s : upstreamStr.split(",")) { String t = s.trim(); if (!t.isEmpty()) CFG.upstreamProxies.add(t); }
                try { saveConfigLocked(configPath, CFG); } catch (Exception e) { logWarn("Seed save failed: " + e.getMessage()); }
            }
        }

        // Init state from config
        ALLOWED_CIDRS = Ssrf.parseCidrs(CFG.allowList);
        DENIED_CIDRS = Ssrf.parseCidrs(CFG.denyList);

        List<String[]> ups = new ArrayList<>();
        for (String it : CFG.upstreamProxies) {
            if (it == null) continue;
            int idx = it.lastIndexOf(':');
            if (idx < 0) continue;
            ups.add(new String[]{it.substring(0, idx), it.substring(idx + 1)});
        }
        UPSTREAM_PROXIES = ups;

        usageLoad(usagePath);

        // Options
        Options opt = new Options();
        opt.username = username;
        opt.password = password;
        opt.authRequired = !username.isEmpty() && !password.isEmpty();
        opt.enableUdp = !noUdp;
        OPTS = opt;

        if (CFG.dashboardUser.equals("admin") && verifyPassword("admin", CFG.dashboardPasswordHash)) {
            logWarn(RED + "Dashboard đang dùng admin/admin — đổi ngay!" + RESET);
        }

        // Start dashboard
        try { startDashboard(dashBind, dashPort); }
        catch (Exception e) { logErr("Dashboard failed: " + e.getMessage()); }

        // Start background
        startBackgroundThreads();

        // Start proxy
        ServerSocket listener = new ServerSocket();
        listener.setReuseAddress(true);
        listener.bind(new InetSocketAddress(listenAddr, listenPort));

        log(GREEN + "Proxy v6.3.6 (Java 21, vThreads) STARTED → " + listenAddr + ":" + listenPort + RESET);
        log(CYAN + "Users: " + CFG.users.size() + " | Upstream: " + UPSTREAM_PROXIES.size() +
            " | Config: " + configPath + RESET);

        // Shutdown hook
        Runtime.getRuntime().addShutdownHook(new Thread(() -> {
            SHUTDOWN = true;
            usageSave(USAGE_PATH);
            try { listener.close(); } catch (Exception ignored) {}
            try { if (dashServer != null) dashServer.stop(0); } catch (Exception ignored) {}
            log(RED + "Proxy STOPPED" + RESET);
        }));

        // Accept loop
        while (!SHUTDOWN) {
            try {
                Socket sock = listener.accept();
                Thread.ofVirtual().name("conn").start(() -> handleConn(sock));
            } catch (Exception e) {
                if (SHUTDOWN) break;
                logErr("Accept: " + e.getMessage());
                try { Thread.sleep(500); } catch (InterruptedException ignored) {}
            }
        }
    }
