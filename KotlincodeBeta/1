def main():
    if not TARGET.exists():
        print(f"Không tìm thấy: {TARGET}"); sys.exit(1)
    ts = time.strftime("%Y%m%d_%H%M%S")
    bak = TARGET.with_suffix(TARGET.suffix + f".{ts}.bak")
    shutil.copy2(TARGET, bak)
    print(f"Backup -> {bak}\n")

    src = TARGET.read_text(encoding="utf-8")
    orig = src

    for old, new, label in PATCHES:
        if old in src:
            src = src.replace(old, new, 1)
            print(f"[ OK ] {label}")
        elif new.strip().splitlines()[0][:60] in src:
            print(f"[SKIP] {label} (đã vá)")
        else:
            print(f"[MISS] {label} — anchor không khớp")
            print(f"        cần: {old[:70]}...")

    if src == orig:
        print("\nKhông có thay đổi.")
        return

    TARGET.write_text(src, encoding="utf-8")
    print(f"\n✅ Đã ghi {TARGET} ({len(src)} bytes)")
    print("\nCompile:")
    print(f"  kotlinc -J-Djansi.force=false {TARGET.name} -include-runtime -d proxy.jar")


