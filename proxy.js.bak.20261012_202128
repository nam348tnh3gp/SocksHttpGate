function loadOrInitConfig() {
  if (fs.existsSync(configPath)) {
    let raw;
    try { raw = fs.readFileSync(configPath, 'utf8'); }
    catch (e) { throw new Error(`Không đọc được config file: ${e.message}`); }
    let cfg;
