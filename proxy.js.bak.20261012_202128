function rotateLog() {
  if (!logFileStream) return;
  try { logFileStream.end(); } catch {}
  for (let i = logMaxBackups - 1; i >= 1; i--) {
    const oldp = `${logFilePath}.${i}`, newp = `${logFilePath}.${i + 1}`;
    try { if (fs.existsSync(oldp)) fs.renameSync(oldp, newp); } catch {}
  }
  if (logMaxBackups > 0) {
    try { if (fs.existsSync(logFilePath)) fs.renameSync(logFilePath, logFilePath + '.1'); } catch {}
  }
  try {
    logFileStream = fs.createWriteStream(logFilePath, { flags: 'a' });
    logFileSize = 0;
  } catch { logFileStream = null; }
}

function initLog() {
  if (!logFilePath) return;
  try {
    logFileStream = fs.createWriteStream(logFilePath, { flags: 'a' });
    try { logFileSize = fs.statSync(logFilePath).size; } catch {}
  } catch (e) {
    console.error(`[FATAL] Không mở được log file ${logFilePath}:`, e.message);
    process.exit(1);
  }
}

function tsFmt() {
  const d = new Date();
  const p = n => String(n).padStart(2, '0');
  return `[${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}]`;
}

function logLine(prefix, msg) {
  const line = `${tsFmt()} ${prefix}${msg}\n`;
  process.stdout.write(line);
  if (logFileStream) {
    if (logMaxSizeBytes > 0 && logFileSize + line.length > logMaxSizeBytes) rotateLog();
    try { logFileStream.write(line); logFileSize += line.length; } catch {}
  }
}

