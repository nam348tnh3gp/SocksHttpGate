function streamHandler(req, res) {
  if (sseClients.size >= DASH_MAX_SSE) {
    let oldest = null;
    for (const c of sseClients) {
      if (!oldest || (c.lastActivity || 0) < (oldest.lastActivity || 0)) oldest = c;
    }
    if (oldest) {
      if (oldest.keepalive) clearInterval(oldest.keepalive);
      sseClients.delete(oldest);
      try { oldest.res.end(); } catch {}
    }
  }

  res.writeHead(200, {
    'Content-Type': 'text/event-stream',
    'Cache-Control': 'no-cache, no-transform',
    'X-Accel-Buffering': 'no',
    'Connection': 'keep-alive',
  });
  if (res.socket) {
    try {
      res.socket.setNoDelay(true);
      res.socket.setTimeout(0);
      res.socket.setKeepAlive(true, 30000);
    } catch {}
  }
  try { res.write(`event: history\ndata: ${JSON.stringify(statHistory)}\n\n`); }
  catch { return; }

  const client = { res, lastActivity: Date.now(), keepalive: null, _bp: 0, _dead: false };
  sseClients.add(client);

  client.keepalive = setInterval(() => {
    if (client._dead) return;
    if (res.writableEnded || res.destroyed) { cleanup(); return; }
    try {
      const ok = res.write(': keepalive\n\n');
      client.lastActivity = Date.now();
      if (!ok) {
        client._bp = (client._bp || 0) + 1;
        if (client._bp >= 3) { cleanup(); return; }
      } else {
        client._bp = 0;
      }
    } catch { cleanup(); }
  }, 15000);

  req.on('close', cleanup);
  req.on('error', cleanup);
  res.on('error', cleanup);

  function cleanup() {
    if (client._dead) return;
    client._dead = true;
    clearInterval(client.keepalive);
    sseClients.delete(client);
    try { res.end(); } catch {}
  }
}

function broadcastSample(sample) {
  if (sseClients.size === 0) return;
  const dead = [];
  const data = `event: sample\ndata: ${JSON.stringify(sample)}\n\n`;
  for (const c of sseClients) {
    if (c.res.writableEnded || c.res.destroyed) { dead.push(c); continue; }
    try {
      const ok = c.res.write(data);
      c.lastActivity = Date.now();
      if (!ok) {
        c._bp = (c._bp || 0) + 1;
        if (c._bp >= 5) dead.push(c);
      } else {
        c._bp = 0;
      }
    } catch { dead.push(c); }
  }
  for (const c of dead) {
    if (c._dead) continue;
    c._dead = true;
    if (c.keepalive) clearInterval(c.keepalive);
    sseClients.delete(c);
    try { c.res.end(); } catch {}
  }
}

// ============================================================================
// STATS REPORTER
// ============================================================================
function statsReporter() {
  const interval = 2000;
  let lastUp = 0, lastDown = 0;
  let first = true;
  let tick = 0;
  setInterval(() => {
    tick++;
    for (const ci of activeConns.values()) flushConnStats(ci);

    const cur = stats.current;
    const up = stats.bytesUp, down = stats.bytesDown;
    const udpUp = stats.udpUp, udpDown = stats.udpDown;
    let s5TCP = 0, s5UDP = 0, httpCount = 0;
    for (const ci of activeConns.values()) {
      if (ci.type === 'SOCKS5_TCP') s5TCP++;
      else if (ci.type === 'SOCKS5_UDP') s5UDP++;
      else if (ci.type === 'HTTP') httpCount++;
    }
    logInfo(`[STATS] Active:${cur} TCP:${s5TCP} UDP:${s5UDP} HTTP:${httpCount} | UDP Assoc:${udpAssocs.size} | Up:${formatBytes(up)} Down:${formatBytes(down)} | UDP Up:${formatBytes(udpUp)} Down:${formatBytes(udpDown)} | Uptime:${Math.floor((Date.now() - stats.startTime) / 1000)}s`);

    let upBps = 0, downBps = 0;
    if (!first) {
      upBps = Math.floor((up - lastUp) / (interval / 1000));
      downBps = Math.floor((down - lastDown) / (interval / 1000));
    }
    lastUp = up; lastDown = down; first = false;

    const sample = {
      t: Math.floor(Date.now() / 1000),
      up_bps: upBps, down_bps: downBps,
      active: cur, udp_assocs: udpAssocs.size,
    };
    statHistory.push(sample);
    if (statHistory.length > HISTORY_MAX_SAMPLES) statHistory.shift();
    broadcastSample(sample);

    if (tick % 5 === 0) enforceQuotaOnActiveConns();
    if (tick % 15 === 0) {
      try { saveUsage(); } catch (e) { logWarn(`saveUsage lỗi: ${e.message}`); }
    }
  }, interval);
}

function enforceQuotaOnActiveConns() {
  const overQuotaUsers = new Set();
  for (const ci of activeConns.values()) {
    if (!ci.username || overQuotaUsers.has(ci.username)) continue;
    const cfg = getUserConfig(ci.username);
    if (!cfg || !cfg.quota_bytes_per_month) continue;
    if (isOverQuota(ci.username, cfg.quota_bytes_per_month)) overQuotaUsers.add(ci.username);
  }
  if (overQuotaUsers.size === 0) return;
  const toKick = [];
  for (const ci of activeConns.values()) {
    if (overQuotaUsers.has(ci.username)) toKick.push(ci);
  }
  for (const ci of toKick) { try { ci.socket.destroy(); } catch {} }
  if (toKick.length) {
    logWarn(`Ngắt ${toKick.length} connection do ${overQuotaUsers.size} user vượt quota: ${[...overQuotaUsers].join(', ')}`);
  }
}

// ============================================================================
// SINGLE-PORT ROUTER
// ============================================================================
function handleSinglePortConnection(socket) {
  const clientIP = (socket.remoteAddress || '').replace(/^::ffff:/, '');
  if (clientIP && !ipAllowed(clientIP)) {
    logWarn(`IP ${clientIP} bị từ chối`);
    socket.destroy(); return;
  }
  if (clientIP && isAuthBlocked(clientIP)) {
    logWarn(`IP ${clientIP} bị chặn`);
    socket.destroy(); return;
  }
  stats.total++; stats.current++;
  socket.setNoDelay(true);
  socket.setTimeout(HANDSHAKE_TIMEOUT_MS);

  const reader = new BufferedReader(socket);
  socket.once('timeout', () => socket.destroy());

  reader.read(1).then(async first => {
    socket.setTimeout(0);
    const b = first[0];
    reader.unread(first);
    if (b === 0x05) {
      return handleSOCKS5(socket, reader);
    }
    if (isHTTPMethodByte(b)) {
      const line = await reader.readLine();
      const parts = line.split(/\s+/);
      if (parts.length < 3) { socket.destroy(); return; }
      const method = parts[0].toUpperCase();
      const rawURL = parts[1];
      const isProxy = method === 'CONNECT' || rawURL.startsWith('http://') || rawURL.startsWith('https://');
      reader.unread(Buffer.from(line + '\r\n', 'latin1'));

      if (isProxy) {
        return handleHTTP(socket, reader);
      } else {
        return routeDashboardOnSocket(socket, reader);
      }
    }
    logWarn(`Unknown protocol from ${clientIP}`);
    socket.destroy();
  }).catch(() => socket.destroy()).finally(() => { stats.current--; });
}

let _singlePortDashServer = null;

function routeDashboardOnSocket(socket, reader) {
  if (reader) {
    try { reader.detach(); } catch {}
  }
  if (!_singlePortDashServer) {
    _singlePortDashServer = http.createServer((req, res) => {
      handleDashboardRequest(req, res).catch(() => { try { res.end(); } catch {} });
    });
    _singlePortDashServer.requestTimeout = 30000;
    _singlePortDashServer.headersTimeout = 15000;
    _singlePortDashServer.keepAliveTimeout = 10000;
    _singlePortDashServer.on('error', (e) => logWarn(`single-port dashboard server error: ${e.message}`));
  }
  try {
    _singlePortDashServer.emit('connection', socket);
    // FIX: BufferedReader.detach() đã pause() socket; Node không tự resume khi
    // gắn listener 'data' sau khi pause → HTTP parser không đọc được bytes đã
    // unshift → dashboard treo. Resume tường minh ngay sau khi emit.
    socket.resume();
  } catch (e) {
    logWarn(`routeDashboardOnSocket fail: ${e.message}`);
    try { socket.destroy(); } catch {}
  }
}

// ============================================================================
// SIGNALS
// ============================================================================
function setupSignals(...servers) {
  process.on('SIGINT', () => shutdown('SIGINT'));
  process.on('SIGTERM', () => shutdown('SIGTERM'));
  process.on('SIGHUP', () => {
    logInfo('Nhận SIGHUP, đang reload config...');
    const err = reloadConfig('SIGHUP');
    if (err) logWarn(`Reload thất bại: ${err}`);
  });

  function shutdown(sig) {
    if (shuttingDown) return;
    shuttingDown = true;
    logInfo(`Nhận ${sig}, graceful shutdown...`);
    for (const s of servers) try { s.close(); } catch {}
    for (const ci of activeConns.values()) try { ci.socket.destroy(); } catch {}
    saveUsage();
    setTimeout(() => process.exit(0), 500);
  }
}

process.on('uncaughtException', (e) => {
  logErr(`uncaughtException: ${e.stack || e.message}`);
});
process.on('unhandledRejection', (e) => {
  logErr(`unhandledRejection: ${(e && e.stack) || e}`);
});

// ============================================================================
// MAIN
// ============================================================================
function main() {
  initLog();
  loadUsage();

  if (!fs.existsSync(configPath) && !args['dashboard-pass']) {
    args['dashboard-pass'] = generateAPIToken().slice(0, 16);
    logWarn(`Dashboard lần đầu — user: ${args['dashboard-user']} | password: ${args['dashboard-pass']} (chỉ hiện MỘT LẦN, hãy đổi ngay)`);
  }

  let cfgResult;
  try { cfgResult = loadOrInitConfig(); }
  catch (e) { logErr(`[FATAL] ${e.message}`); process.exit(1); }

  if (cfgResult.created) {
    for (const item of String(args.allow || '').split(',')) {
      if (item.trim()) cfgResult.cfg.allow_list.push(item.trim());
    }
    for (const item of String(args.deny || '').split(',')) {
      if (item.trim()) cfgResult.cfg.deny_list.push(item.trim());
    }
    for (const item of String(args.upstream || '').split(',')) {
      if (item.trim()) cfgResult.cfg.upstream_proxies.push(item.trim());
    }
    try { saveConfigSync(cfgResult.cfg); } catch {}
  }

  appConfig = cfgResult.cfg;
  dashboardUser = appConfig.dashboard_user;
  dashboardPassHash = appConfig.dashboard_password_hash;
  const ap = parseCIDRList(appConfig.allow_list);
  const dp = parseCIDRList(appConfig.deny_list);
  allowedCIDRs = ap.result;
  deniedCIDRs = dp.result;

  globalServerOpts = {
    serverUsername: args.u || '',
    serverPassword: args.P || '',
    authEnabled: !!(args.u && args.P),
  };

  const singlePort = !!args['single-port'];
  const listenAddr = args.l;
  const listenPort = args.p;
  const dashboardPort = args['dashboard-port'];
  const dashboardBind = args['dashboard-bind'];

  const servers = [];

  if (singlePort) {
    const server = net.createServer(handleSinglePortConnection);
    server.on('error', e => logErr(`Listener error: ${e.message}`));
    server.listen(listenPort, listenAddr, () => {
      logInfo(`Proxy v6.3 (Node, single-port) STARTED → ${listenAddr}:${listenPort}`);
      logInfo(`Features: SOCKS5 TCP/UDP + HTTP/HTTPS + Dashboard | Auth: ${authRequired() ? 'yes' : 'no'} | Users: ${appConfig.users.length} | Upstream: ${appConfig.upstream_proxies.length} | Config: ${configPath}`);
    });
    servers.push(server);

    logInfo(`Dashboard (single-port mode) cùng port với proxy: ${listenAddr}:${listenPort}`);
  } else {
    const proxyServer = net.createServer(handleConnection);
    proxyServer.on('error', e => logErr(`Proxy listener error: ${e.message}`));
    proxyServer.listen(listenPort, listenAddr, () => {
      logInfo(`Proxy v6.3 (Node) STARTED → ${listenAddr}:${listenPort} [worker ${MY_WORKER_ID || 'main'}]`);
      logInfo(`Features: SOCKS5 TCP/UDP + HTTP/HTTPS | Auth: ${authRequired() ? 'yes' : 'no'} | Users: ${appConfig.users.length} | Upstream: ${appConfig.upstream_proxies.length} | Config: ${configPath}`);
    });
    servers.push(proxyServer);

    if (IS_DASHBOARD_LEADER) {
      const dashServer = http.createServer((req, res) => {
        handleDashboardRequest(req, res).catch(e => {
          try { res.writeHead(500); res.end('{"error":"internal"}'); } catch {}
        });
      });
      dashServer.requestTimeout = 30000;
      dashServer.headersTimeout = 15000;
      dashServer.keepAliveTimeout = 10000;
      dashServer.maxRequestsPerSocket = 0;
      dashServer.on('error', e => logErr(`Dashboard listener error: ${e.message}`));
      dashServer.listen(dashboardPort, dashboardBind, () => {
        logInfo(`Dashboard available at http://${dashboardBind}:${dashboardPort} (user: ${dashboardUser})`);
      });
      servers.push(dashServer);
    } else {
      logInfo(`[worker ${MY_WORKER_ID}] Skip dashboard listener (chỉ worker 1 mở port ${dashboardPort})`);
    }
  }

  setupSignals(...servers);
  statsReporter();

  if (IS_WORKER) {
    if (IS_DASHBOARD_LEADER) {
      process.on('message', (msg) => {
        if (!msg) return;
        if (msg.type === 'peer_stats') {
          peerStats.set(msg.workerId, { payload: msg.payload, t: Date.now() });
        } else if (msg.type === 'kick') {
          const ci = activeConns.get(msg.id);
          if (ci) { try { ci.socket.destroy(); } catch {} }
        } else if (msg.type === 'reload') {
          try { reloadConfig('master'); } catch {}
        }
      });
    } else {
      process.on('message', (msg) => {
        if (!msg) return;
        if (msg.type === 'kick') {
          const ci = activeConns.get(msg.id);
          if (ci) { try { ci.socket.destroy(); } catch {} }
        } else if (msg.type === 'reload') {
          try { reloadConfig('master'); } catch {}
        }
      });

      setInterval(() => {
        if (!process.send) return;
        try {
          const conns = [];
          for (const ci of activeConns.values()) {
            conns.push({
              id: ci.id, ip: ci.ip, port: ci.port, type: ci.type, target: ci.target,
              user: ci.username,
              start_time: Math.floor(ci.startTime / 1000),
              bytes_up: ci.bytesUp, bytes_down: ci.bytesDown,
              duration: (Date.now() - ci.startTime) / 1000,
            });
          }
          process.send({
            type: 'stats',
            payload: {
              total: stats.total, current: stats.current,
              socks5TCP: stats.socks5TCP, socks5UDP: stats.socks5UDP,
              http: stats.http, authFail: stats.authFail,
              bytesUp: stats.bytesUp, bytesDown: stats.bytesDown,
              udpUp: stats.udpUp, udpDown: stats.udpDown,
              udpAssocs: udpAssocs.size,
              active_connections: conns,
              uptime: (Date.now() - stats.startTime) / 1000,
            },
          });
        } catch {}
      }, 1000);
    }
  }

  logInfo(`Gửi SIGHUP (kill -HUP ${process.pid}) để reload config không cần restart`);
  if (!authRequired()) logWarn('Proxy KHÔNG có xác thực — bất kỳ ai kết nối được đều dùng được');
}

main();
