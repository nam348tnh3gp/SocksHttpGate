const auditLog = [];
function recordAudit(actor, action, details) {
  auditLog.push({ t: Math.floor(Date.now() / 1000), actor, action, details: details || '' });
  if (auditLog.length > AUDIT_LOG_MAX) auditLog.splice(0, auditLog.length - AUDIT_LOG_MAX);
}

const reloadHistory = [];
function recordReloadEvent(ev) {
  reloadHistory.push(ev);
  if (reloadHistory.length > RELOAD_HISTORY_MAX) reloadHistory.splice(0, reloadHistory.length - RELOAD_HISTORY_MAX);
}

// ============================================================================
// RELOAD CONFIG
// ============================================================================
function reloadConfig(source) {
  const ev = { t: Math.floor(Date.now() / 1000), source, success: false };
  let raw;
  try { raw = fs.readFileSync(configPath, 'utf8'); }
  catch (e) { ev.error = `không đọc được config file: ${e.message}`; recordReloadEvent(ev); return ev.error; }
  let cfg;
  try { cfg = JSON.parse(raw); }
  catch (e) { ev.error = `config file lỗi định dạng JSON: ${e.message}`; recordReloadEvent(ev); return ev.error; }
  if (!cfg.dashboard_user || !cfg.dashboard_password_hash) {
    ev.error = 'config file thiếu dashboard_user/dashboard_password_hash';
    recordReloadEvent(ev); return ev.error;
  }
  cfg.users = cfg.users || [];
  cfg.allow_list = cfg.allow_list || [];
  cfg.deny_list = cfg.deny_list || [];
  cfg.upstream_proxies = cfg.upstream_proxies || [];
  cfg.api_tokens = cfg.api_tokens || [];

  const ap = parseCIDRList(cfg.allow_list);
  const dp = parseCIDRList(cfg.deny_list);
  allowedCIDRs = ap.result;
  deniedCIDRs = dp.result;
  const invalid = [...ap.invalid, ...dp.invalid];

  appConfig = cfg;
  dashboardUser = cfg.dashboard_user;
  dashboardPassHash = cfg.dashboard_password_hash;

  for (const u of cfg.users) applyLiveBandwidthLimit(u.username, u.max_bandwidth_bps || 0);

  ev.success = true;
  ev.allow_count = allowedCIDRs.length;
  ev.deny_count = deniedCIDRs.length;
  ev.upstream_count = cfg.upstream_proxies.length;
  ev.user_count = cfg.users.length;
  if (invalid.length) ev.invalid_cidrs = invalid;
  recordReloadEvent(ev);
  logInfo(`Đã reload config (nguồn: ${source}): ${ev.allow_count} allow, ${ev.deny_count} deny, ${ev.upstream_count} upstream, ${ev.user_count} user${invalid.length ? ` (CẢNH BÁO: ${invalid.length} CIDR sai)` : ''}`);
  return null;
}

// ============================================================================
// USER / AUTH
// ============================================================================
function getUserConfig(username) {
  if (!username) return null;
  return appConfig.users.find(u => u.username === username) || null;
}

function countUserConns(username) {
  let n = 0;
  for (const ci of activeConns.values()) if (ci.username === username) n++;
  return n;
}

function checkUserLimits(username) {
  if (!username) return { ok: true };
  const cfg = getUserConfig(username);
  if (!cfg) return { ok: true };
  const maxc = cfg.max_connections || 0;
  const quota = cfg.quota_bytes_per_month || 0;
  if (maxc > 0 && countUserConns(username) >= maxc) {
    return { ok: false, reason: `đã đạt giới hạn ${maxc} connection đồng thời` };
  }
  if (quota > 0 && isOverQuota(username, quota)) {
    return { ok: false, reason: 'đã vượt quota dung lượng tháng này' };
  }
  return { ok: true };
}

function authenticateProxyUser(user, pass) {
  if (globalServerOpts.authEnabled
      && user === globalServerOpts.serverUsername
      && pass === globalServerOpts.serverPassword) {
    return { ok: true, limit: 0, user };
  }
  for (const u of appConfig.users) {
    if (u.username === user && verifyPasswordCached(pass, u.password_hash)) {
      return { ok: true, limit: u.max_bandwidth_bps || 0, user: u.username };
    }
  }
  return { ok: false };
}

function authRequired() {
  if (globalServerOpts.authEnabled) return true;
  return !!(appConfig.require_proxy_auth || appConfig.users.length > 0);
}

// ============================================================================
// CONNECTION TRACKING
// ============================================================================
function makeConnInfo(opts) {
  const ci = {
    id: nextConnID(),
    ip: opts.ip, port: opts.port,
    type: opts.type, target: opts.target,
    startTime: Date.now(),
    bytesUp: 0, bytesDown: 0,
    rateLimitBps: opts.rateLimitBps || 0,
    username: opts.username || '',
    socket: opts.socket,
    flushedUp: 0, flushedDown: 0,
  };
  activeConns.set(ci.id, ci);
  return ci;
}

function flushConnStats(ci) {
  const dUp = ci.bytesUp - ci.flushedUp;
  const dDown = ci.bytesDown - ci.flushedDown;
  ci.flushedUp = ci.bytesUp;
  ci.flushedDown = ci.bytesDown;
  if (dUp <= 0 && dDown <= 0) return;
  stats.bytesUp += dUp;
  stats.bytesDown += dDown;
  addUsage(ci.username, dUp + dDown);
}

function applyLiveBandwidthLimit(username, newLimitBps) {
  if (!username) return;
  let n = 0;
  for (const ci of activeConns.values()) {
    if (ci.username !== username) continue;
    if (ci._rampInterval) { clearInterval(ci._rampInterval); ci._rampInterval = null; }
    if (ci.rateLimitBps > 0 && newLimitBps > 0 && ci.rateLimitBps !== newLimitBps) {
      const from = ci.rateLimitBps, to = newLimitBps;
      let i = 0;
      ci._rampInterval = setInterval(() => {
        i++;
        ci.rateLimitBps = from + Math.floor((to - from) * i / BANDWIDTH_RAMP_STEPS);
        if (i >= BANDWIDTH_RAMP_STEPS) {
          clearInterval(ci._rampInterval);
          ci._rampInterval = null;
        }
      }, BANDWIDTH_RAMP_INTERVAL_MS);
    } else {
      ci.rateLimitBps = newLimitBps > 0 ? newLimitBps : 0;
    }
    n++;
  }
  if (n) logInfo(`Áp dụng giới hạn băng thông mới (${newLimitBps} bytes/s) cho ${n} conn của '${username}'`);
}

// ============================================================================
// THROTTLE
// ============================================================================
async function throttledWrite(socket, buf, ci) {
  if (!socket.writable) return false;
  const ok = socket.write(buf);
  const rate = ci.rateLimitBps;
  if (rate > 0) {
    const delayMs = (buf.length / rate) * 1000;
    if (delayMs >= 1) await new Promise(r => setTimeout(r, Math.min(delayMs, 1500)));
  }
  if (!ok) await new Promise(r => socket.once('drain', r));
  return true;
}

// ============================================================================
// BUFFERED READER
// ============================================================================
class BufferedReader {
  constructor(socket) {
    this.socket = socket;
    this.buffer = Buffer.alloc(0);
    this._waiter = null;
    this._eof = false;
    this._err = null;
    this._onData = c => {
      this.buffer = Buffer.concat([this.buffer, c]);
      this._tryResolve();
    };
    this._onEnd = () => { this._eof = true; this._tryResolve(); };
    this._onErr = e => { this._err = e; this._tryResolve(); };
    socket.on('data', this._onData);
    socket.on('end', this._onEnd);
    socket.on('error', this._onErr);
    socket.pause();
  }

  _tryResolve() {
    if (this._waiter) this._waiter.check();
  }

  unread(buf) {
    if (!buf || buf.length === 0) return;
    this.buffer = Buffer.concat([buf, this.buffer]);
    this._tryResolve();
  }

  read(n) {
    return new Promise((resolve, reject) => {
      const check = () => {
        if (this.buffer.length >= n) {
          const out = this.buffer.slice(0, n);
          this.buffer = this.buffer.slice(n);
          this._waiter = null;
          resolve(out);
          return true;
        }
        if (this._err) { this._waiter = null; reject(this._err); return true; }
        if (this._eof) { this._waiter = null; reject(new Error('EOF')); return true; }
        return false;
      };
      if (check()) return;
      this._waiter = { check };
      this.socket.resume();
    });
  }

  readLine(maxLen = MAX_LINE_BYTES) {
    return new Promise((resolve, reject) => {
      const check = () => {
        const idx = this.buffer.indexOf(0x0A);
        if (idx >= 0) {
          let end = idx;
          if (end > 0 && this.buffer[end - 1] === 0x0D) end--;
          const line = this.buffer.slice(0, end).toString('latin1');
          this.buffer = this.buffer.slice(idx + 1);
          this._waiter = null;
          resolve(line);
          return true;
        }
        if (this.buffer.length > maxLen) { this._waiter = null; reject(new Error('line too long')); return true; }
        if (this._err) { this._waiter = null; reject(this._err); return true; }
        if (this._eof) { this._waiter = null; reject(new Error('EOF')); return true; }
        return false;
      };
      if (check()) return;
      this._waiter = { check };
      this.socket.resume();
    });
  }

  drain() {
    const out = this.buffer;
    this.buffer = Buffer.alloc(0);
    return out;
  }

  detach() {
    this.socket.removeListener('data', this._onData);
    this.socket.removeListener('end', this._onEnd);
    this.socket.removeListener('error', this._onErr);
    this.socket.pause();
    const left = this.drain();
    if (left.length > 0) {
      try { this.socket.unshift(left); } catch {}
    }
  }
}

// ============================================================================
// CONNECT TARGET
// ============================================================================
async function connectTarget(host, port) {
  if (appConfig.upstream_proxies && appConfig.upstream_proxies.length) {
    for (const up of appConfig.upstream_proxies) {
      const m = up.match(/^(?:socks5|http|https):\/\/(.+)$/i);
      const cleaned = m ? m[1] : up;
      const idx = cleaned.lastIndexOf(':');
      if (idx <= 0) continue;
      const uh = cleaned.slice(0, idx);
      const upPort = parseInt(cleaned.slice(idx + 1), 10);
      if (!uh || !upPort || upPort < 1 || upPort > 65535) continue;
      try {
        const sock = await new Promise((resolve, reject) => {
          const s = net.createConnection({ host: uh, port: upPort, timeout: CONNECTION_TIMEOUT_MS },
            () => { s.setTimeout(0); resolve(s); });
          s.once('error', reject);
          s.once('timeout', () => { s.destroy(); reject(new Error('timeout')); });
        });
        return sock;
      } catch (e) {
        logWarn(`Upstream ${up} lỗi: ${e.message}`);
      }
    }
  }
  const ips = await resolveAndCheck(host);
  return new Promise((resolve, reject) => {
    const ip = ips[0];
    const s = net.createConnection({ host: ip, port, timeout: CONNECTION_TIMEOUT_MS },
      () => { s.setTimeout(0); s.setNoDelay(true); resolve(s); });
    s.once('error', reject);
    s.once('timeout', () => { s.destroy(); reject(new Error('timeout')); });
  });
}

// ============================================================================
// TUNNEL
// ============================================================================
async function pump(src, dst, ci, dir) {
  while (true) {
    const chunk = await new Promise((resolve) => {
      let done = false;
      const cleanup = () => {
        src.removeListener('data', onData);
        src.removeListener('end', onEnd);
        src.removeListener('error', onEnd);
      };
      const onData = (c) => {
        if (done) return;
        done = true;
        src.pause();
        cleanup();
        resolve(c);
      };
      const onEnd = () => {
        if (done) return;
        done = true;
        cleanup();
        resolve(null);
      };
      src.on('data', onData);
      src.once('end', onEnd);
      src.once('error', onEnd);
      src.resume();
    });
    if (chunk === null) break;
    try {
      await throttledWrite(dst, chunk, ci);
    } catch { break; }
    if (dir === 'up') ci.bytesUp += chunk.length;
    else ci.bytesDown += chunk.length;
  }
  try { dst.end(); } catch {}
}

async function tunnel(socketA, socketB, ci) {
  const p1 = pump(socketA, socketB, ci, 'up');
  const p2 = pump(socketB, socketA, ci, 'down');
  try { await Promise.all([p1, p2]); } catch {}
  flushConnStats(ci);
  try { socketA.destroy(); } catch {}
  try { socketB.destroy(); } catch {}
}

// ============================================================================
// SOCKS5
// ============================================================================
function ipv4ToBuf(ip) {
  const p = ip.split('.').map(x => parseInt(x, 10));
  return Buffer.from(p);
}
function ipv6ToBuf(ip) {
  const e = expandIPv6(ip);
  if (!e) return Buffer.alloc(16);
  const g = e.split(':').map(x => parseInt(x, 16));
  const b = Buffer.alloc(16);
  for (let i = 0; i < 8; i++) b.writeUInt16BE(g[i] || 0, i * 2);
  return b;
}
function bufToIP(buf, atyp) {
  if (atyp === 0x01) return buf.slice(0, 4).join('.');
  if (atyp === 0x04) {
    const g = [];
    for (let i = 0; i < 8; i++) g.push(buf.readUInt16BE(i * 2).toString(16));
    return g.join(':');
  }
  return null;
}

function socks5Reply(socket, rep, ipStr, port) {
  let atyp, ipBuf;
  if (!ipStr) ipStr = '0.0.0.0';
  if (ipStr.includes(':')) { atyp = 0x04; ipBuf = ipv6ToBuf(ipStr); }
  else { atyp = 0x01; ipBuf = ipv4ToBuf(ipStr); }
  const pb = Buffer.alloc(2);
  pb.writeUInt16BE(port || 0, 0);
  try { socket.write(Buffer.concat([Buffer.from([5, rep, 0, atyp]), ipBuf, pb])); } catch {}
}

async function handleSOCKS5(socket, reader) {
  const clientIP = (socket.remoteAddress || '').replace(/^::ffff:/, '');
  const clientPort = socket.remotePort;
  let username = '', rateLimitBps = 0;
  let ci = null;

  try {
    const ver = await reader.read(1);
    if (ver[0] !== 0x05) { socket.destroy(); return; }
    const nm = await reader.read(1);
    const methods = await reader.read(nm[0]);
    const needAuth = authRequired();
    const want = needAuth ? 0x02 : 0x00;
    if (!methods.includes(want)) {
      socket.write(Buffer.from([5, 0xFF]));
      socket.destroy();
      return;
    }
    socket.write(Buffer.from([5, want]));

    if (needAuth) {
      const av = await reader.read(1);
      if (av[0] !== 1) { socket.write(Buffer.from([1, 0xFF])); socket.destroy(); return; }
      const ulen = (await reader.read(1))[0];
      const u = (await reader.read(ulen)).toString('utf8');
      const plen = (await reader.read(1))[0];
      const p = (await reader.read(plen)).toString('utf8');
      const res = authenticateProxyUser(u, p);
      if (!res.ok) {
        socket.write(Buffer.from([1, 0xFF]));
        logWarn(`SOCKS5 auth fail from ${clientIP}`);
        stats.authFail++;
        recordAuthFail(clientIP, AUTH_FAIL_THRESHOLD);
        socket.destroy();
        return;
      }
      socket.write(Buffer.from([1, 0x00]));
      resetAuthFail(clientIP);
      username = res.user;
      rateLimitBps = res.limit;
      const lim = checkUserLimits(username);
      if (!lim.ok) {
        logWarn(`SOCKS5 từ chối user '${username}': ${lim.reason}`);
        socks5Reply(socket, 0x02, null, 0);
        socket.destroy();
        return;
      }
    }

    const req = await reader.read(4);
    if (req[0] !== 5) { socket.destroy(); return; }
    const cmd = req[1], atyp = req[3];

    let host = '', port = 0;
    if (atyp === 0x01) {
      const ipb = await reader.read(4);
      const pb = await reader.read(2);
      host = ipb.join('.');
      port = pb.readUInt16BE(0);
    } else if (atyp === 0x03) {
      const len = (await reader.read(1))[0];
      const h = await reader.read(len);
      const pb = await reader.read(2);
      host = h.toString('ascii');
      port = pb.readUInt16BE(0);
      if (!host || !/^[A-Za-z0-9._\-:]+$/.test(host)) {
        socks5Reply(socket, 0x01, null, 0); socket.destroy(); return;
      }
    } else if (atyp === 0x04) {
      const ipb = await reader.read(16);
      const pb = await reader.read(2);
      host = bufToIP(ipb, 0x04);
      port = pb.readUInt16BE(0);
    } else {
      socks5Reply(socket, 0x08, null, 0); socket.destroy(); return;
    }

    if (cmd === 0x01) {
      const target = `${host}:${port}`;
      logInfo(`SOCKS5 TCP → ${clientIP}:${clientPort} → ${target}`);
      ci = makeConnInfo({ ip: clientIP, port: clientPort, type: 'SOCKS5_TCP', target, rateLimitBps, username, socket });
      stats.socks5TCP++;

      let remote;
      try {
        remote = await connectTarget(host, port);
      } catch (e) {
        logWarn(`SOCKS5 connect fail: ${e.message}`);
        socks5Reply(socket, 0x05, null, 0);
        activeConns.delete(ci.id);
        socket.destroy();
        return;
      }
      const la = remote.localAddress || '0.0.0.0';
      const lp = remote.localPort || 0;
      socks5Reply(socket, 0x00, la, lp);

      reader.detach();

      await tunnel(socket, remote, ci);
      activeConns.delete(ci.id);
    } else if (cmd === 0x03) {
      if (args['no-udp']) {
        socks5Reply(socket, 0x07, null, 0);
        socket.destroy();
        return;
      }
      const target = host ? `UDP:${host}:${port}` : 'UDP:any';
      logInfo(`SOCKS5 UDP → ${clientIP}:${clientPort} → ${target}`);
      await handleUDPAssociate(socket, reader, clientIP, clientPort, username, rateLimitBps, target);
    } else {
      socks5Reply(socket, 0x07, null, 0);
      socket.destroy();
    }
  } catch (e) {
    if (ci) { flushConnStats(ci); activeConns.delete(ci.id); }
    try { socket.destroy(); } catch {}
  }
}

// ============================================================================
// UDP ASSOCIATE
// ============================================================================
async function handleUDPAssociate(socket, reader, clientIP, clientPort, username, rateLimitBps, target) {
  const family = socket.remoteFamily === 'IPv6' ? 'udp6' : 'udp4';
  const relay = dgram.createSocket(family);
  try {
    await new Promise((resolve, reject) => {
      relay.once('error', reject);
      relay.bind(0, () => resolve());
    });
  } catch (e) {
    logErr(`UDP relay bind thất bại: ${e.message}`);
    socks5Reply(socket, 0x01, null, 0);
    socket.destroy();
    return;
  }
  const boundPort = relay.address().port;

  const ci = makeConnInfo({ ip: clientIP, port: clientPort, type: 'SOCKS5_UDP', target, rateLimitBps, username, socket });
  stats.socks5UDP++;

  const replyIP = (socket.localAddress || '0.0.0.0').replace(/^::ffff:/, '');
  socks5Reply(socket, 0x00, replyIP, boundPort);
  logInfo(`UDP relay bound ${replyIP}:${boundPort}`);

  const assoc = {
    clientIP, clientPort: null, clientKnown: false,
    relaySocket: relay,
    destMap: new Map(),
    lastActivity: Date.now(),
    username,
    active: true,
    ci,
  };
  const key = `${clientIP}:${clientPort}`;
  udpAssocs.set(key, assoc);

  relay.on('message', (msg, rinfo) => {
    assoc.lastActivity = Date.now();
    const fIP = rinfo.address.replace(/^::ffff:/, '');
    const fPort = rinfo.port;

    if (!assoc.clientKnown) {
      if (fIP !== clientIP) {
        logWarn(`UDP bỏ packet từ ${fIP}:${fPort} (khác client TCP ${clientIP})`);
        return;
      }
      assoc.clientKnown = true;
      assoc.clientPort = fPort;
      logInfo(`UDP client learned: ${fIP}:${fPort}`);
    }
    if (fIP === assoc.clientIP && fPort === assoc.clientPort) {
      handleUDPFromClient(assoc, msg, ci);
    } else if (assoc.clientKnown) {
      handleUDPFromRemote(assoc, msg, fIP, fPort, ci);
    }
  });

  relay.on('error', (e) => logWarn(`UDP relay error: ${e.message}`));

  const idleTimer = setInterval(() => {
    if (Date.now() - assoc.lastActivity > UDP_IDLE_TIMEOUT_MS) shutdown();
  }, 5000);

  socket.once('close', () => shutdown());
  socket.once('error', () => shutdown());
  socket.once('end', () => shutdown());

  let shutdown = function () {
    if (!assoc.active) return;
    assoc.active = false;
    clearInterval(idleTimer);
    try { relay.close(); } catch {}
    udpAssocs.delete(key);
    flushConnStats(ci);
    activeConns.delete(ci.id);
    try { socket.destroy(); } catch {}
    logInfo(`UDP association ended (${clientIP}:${clientPort})`);
  };

  try { reader.detach(); } catch {}
  socket.on('data', () => { /* ignore control bytes */ });
  socket.resume();

  await new Promise(resolve => {
    const origShutdown = shutdown;
    shutdown = function () {
      origShutdown();
      resolve();
    };
    if (!assoc.active) resolve();
  });
}

function handleUDPFromClient(assoc, pkt, ci) {
  if (pkt.length < 4 || pkt[2] !== 0) return;
  const atyp = pkt[3];
  let pos = 4, host = '';
  if (atyp === 0x01) {
    if (pkt.length < pos + 6) return;
    host = `${pkt[pos]}.${pkt[pos + 1]}.${pkt[pos + 2]}.${pkt[pos + 3]}`;
    pos += 4;
  } else if (atyp === 0x03) {
    if (pkt.length < pos + 1) return;
    const len = pkt[pos]; pos++;
    if (pkt.length < pos + len + 2 || len === 0) return;
    host = pkt.slice(pos, pos + len).toString('ascii');
    pos += len;
    if (!/^[A-Za-z0-9._\-:]+$/.test(host)) return;
  } else if (atyp === 0x04) {
    if (pkt.length < pos + 18) return;
    host = bufToIP(pkt.slice(pos, pos + 16), 0x04);
    pos += 16;
  } else return;
  const port = pkt.readUInt16BE(pos); pos += 2;
  const payload = pkt.slice(pos);

  resolveAndCheck(host).then(ips => {
    const destIP = ips[0];
    const destKey = `${destIP}:${port}`;
    if (assoc.destMap.size >= UDP_DEST_MAX) assoc.destMap.clear();
    assoc.destMap.set(destKey, Date.now());
    assoc.relaySocket.send(payload, port, destIP, (err) => {
      if (err) { logWarn(`UDP sendto ${destIP}:${port} fail: ${err.message}`); return; }
      stats.udpUp += payload.length;
      ci.bytesUp += payload.length;
      addUsage(assoc.username, payload.length);
    });
  }).catch(e => logWarn(`UDP relay bị chặn tới ${host}:${port}: ${e.message}`));
}

function handleUDPFromRemote(assoc, data, fromIP, fromPort, ci) {
  if (!assoc.clientKnown || !assoc.clientPort) return;
  const key = `${fromIP}:${fromPort}`;
  if (!assoc.destMap.has(key)) return;
  let atyp, addrBuf;
  if (fromIP.includes(':')) { atyp = 0x04; addrBuf = ipv6ToBuf(fromIP); }
  else { atyp = 0x01; addrBuf = ipv4ToBuf(fromIP); }
  const pb = Buffer.alloc(2);
  pb.writeUInt16BE(fromPort, 0);
  const out = Buffer.concat([Buffer.from([0, 0, 0, atyp]), addrBuf, pb, data]);
  assoc.relaySocket.send(out, assoc.clientPort, assoc.clientIP, (err) => {
    if (err) { logWarn(`UDP reply→client fail: ${err.message}`); return; }
    stats.udpDown += data.length;
    ci.bytesDown += data.length;
    addUsage(assoc.username, data.length);
  });
}

// ============================================================================
// HTTP PROXY
// ============================================================================
async function handleHTTP(socket, reader) {
  const clientIP = (socket.remoteAddress || '').replace(/^::ffff:/, '');
  const clientPort = socket.remotePort;
  let ci = null;

  try {
    const reqLine = await reader.readLine();
    const parts = reqLine.split(/\s+/);
    if (parts.length < 3) {
      socket.write('HTTP/1.1 400 Bad Request\r\n\r\n'); socket.destroy(); return;
    }
    const method = parts[0].toUpperCase();
    const rawURL = parts[1];

    const headers = {};
    for (let i = 0; i < MAX_HEADER_LINES; i++) {
      const line = await reader.readLine();
      if (line === '') break;
      const idx = line.indexOf(':');
      if (idx > 0) {
        const k = line.slice(0, idx).trim().toLowerCase();
        const v = line.slice(idx + 1).trim();
        if (!headers[k]) headers[k] = [];
        headers[k].push(v);
      }
    }

    let username = '', rateLimitBps = 0;
    if (authRequired()) {
      const auth = (headers['proxy-authorization'] || [])[0] || '';
      const decoded = basicAuthDecode(auth);
      if (!decoded) {
        socket.write('HTTP/1.1 407 Proxy Authentication Required\r\nProxy-Authenticate: Basic realm="Proxy"\r\n\r\n');
        socket.destroy(); return;
      }
      const res = authenticateProxyUser(decoded.user, decoded.pass);
      if (!res.ok) {
        try { socket.write('HTTP/1.1 407 Proxy Authentication Required\r\nProxy-Authenticate: Basic realm="Proxy"\r\n\r\n'); } catch {}
        stats.authFail++;
        recordAuthFail(clientIP, AUTH_FAIL_THRESHOLD);
        socket.destroy(); return;
      }
      resetAuthFail(clientIP);
      username = res.user;
      rateLimitBps = res.limit;
      const lim = checkUserLimits(username);
      if (!lim.ok) {
        logWarn(`HTTP từ chối user '${username}': ${lim.reason}`);
        try { socket.write(`HTTP/1.1 429 Too Many Requests\r\nContent-Type: text/plain\r\n\r\n${lim.reason}`); } catch {}
        socket.destroy(); return;
      }
    }

    let host = '', port = 0, parsedURL = null;
    if (method === 'CONNECT') {
      const m = rawURL.match(/^\[([^\]]+)\]:(\d+)$/) || rawURL.match(/^([^:]+):(\d+)$/);
      if (!m) { socket.write('HTTP/1.1 400 Bad Request\r\n\r\n'); socket.destroy(); return; }
      host = m[1];
      port = parseInt(m[2], 10);
      if (!port || port < 1 || port > 65535) { socket.write('HTTP/1.1 400 Bad Request\r\n\r\n'); socket.destroy(); return; }
    } else {
      let u;
      try { u = new URL(rawURL); } catch { socket.write('HTTP/1.1 400 Bad Request\r\n\r\n'); socket.destroy(); return; }
      host = u.hostname;
      port = u.port ? parseInt(u.port, 10) : (u.protocol === 'https:' ? 443 : 80);
      parsedURL = u;
    }

    const target = net.isIPv6(host) ? `[${host}]:${port}` : `${host}:${port}`;
    logInfo(`HTTP ${method} → ${clientIP}:${clientPort} → ${target}`);
    ci = makeConnInfo({ ip: clientIP, port: clientPort, type: 'HTTP', target, rateLimitBps, username, socket });
    stats.http++;

    let remote;
    try {
      remote = await connectTarget(host, port);
    } catch (e) {
      logWarn(`HTTP connect fail: ${e.message}`);
      socket.write('HTTP/1.1 502 Bad Gateway\r\n\r\n');
      activeConns.delete(ci.id);
      socket.destroy(); return;
    }

    if (method === 'CONNECT') {
      try { socket.write('HTTP/1.1 200 Connection Established\r\n\r\n'); } catch {}
      reader.detach();
      await tunnel(socket, remote, ci);
      flushConnStats(ci);
      activeConns.delete(ci.id);
      return;
    }

    const path = (parsedURL.pathname || '/') + (parsedURL.search || '');
    const outLines = [`${method} ${path} HTTP/1.1`];
    const hostHeader = parsedURL.port && !isDefaultPort(parsedURL)
      ? `${parsedURL.hostname}:${parsedURL.port}`
      : parsedURL.hostname;
    if (!headers['host']) outLines.push(`Host: ${hostHeader}`);
    for (const [k, vals] of Object.entries(headers)) {
      if (['proxy-authorization', 'proxy-connection', 'connection', 'keep-alive', 'expect', 'upgrade', 'te'].includes(k)) continue;
      for (const v of vals) outLines.push(`${k}: ${v}`);
    }
    outLines.push('Connection: close');
    outLines.push('');
    outLines.push('');
    const reqBuf = Buffer.from(outLines.join('\r\n'), 'latin1');
    await throttledWrite(remote, reqBuf, ci);
    ci.bytesUp += reqBuf.length;

    const cl = headers['content-length'] ? parseInt(headers['content-length'][0], 10) : -1;
    const te = (headers['transfer-encoding'] || []).map(s => s.toLowerCase());
    if (cl >= 0 && te.length > 0) {
      logWarn(`HTTP request có cả Content-Length và Transfer-Encoding — từ chối`);
      try { socket.write('HTTP/1.1 400 Bad Request\r\n\r\n'); } catch {}
      activeConns.delete(ci.id);
      socket.destroy();
      return;
    }
    if (te.length > 0 && !(te.length === 1 && te[0] === 'chunked')) {
      try { socket.write('HTTP/1.1 400 Bad Request\r\n\r\n'); } catch {}
      activeConns.delete(ci.id);
      socket.destroy();
      return;
    }
    if (cl >= 0 && te.length === 0) {
      if (cl > 0) {
        const body = await reader.read(cl);
        await throttledWrite(remote, body, ci);
        ci.bytesUp += body.length;
      }
    } else if (te.length === 1 && te[0] === 'chunked') {
      while (true) {
        const line = await reader.readLine(1024);
        const semi = line.indexOf(';');
        const szStr = (semi >= 0 ? line.slice(0, semi) : line).trim();
        const sz = parseInt(szStr, 16);
        if (isNaN(sz) || sz < 0) break;
        await throttledWrite(remote, Buffer.from(line + '\r\n'), ci);
        if (sz === 0) {
          for (let t = 0; t < MAX_HEADER_LINES; t++) {
            const tl = await reader.readLine();
            await throttledWrite(remote, Buffer.from(tl + '\r\n'), ci);
            if (tl === '') break;
          }
          break;
        }
        const chunk = await reader.read(sz);
        await throttledWrite(remote, chunk, ci);
        const crlf = await reader.read(2);
        await throttledWrite(remote, crlf, ci);
        ci.bytesUp += sz + 2;
      }
    }

    reader.detach();
    const p2 = pump(remote, socket, ci, 'down');
    await p2.catch(() => {});
    flushConnStats(ci);
    activeConns.delete(ci.id);
    try { remote.destroy(); } catch {}
    try { socket.destroy(); } catch {}
  } catch (e) {
    if (ci) { flushConnStats(ci); activeConns.delete(ci.id); }
    try { socket.destroy(); } catch {}
  }
}

function isDefaultPort(u) {
  return (u.protocol === 'http:' && u.port === '80') || (u.protocol === 'https:' && u.port === '443');
}

function basicAuthDecode(authHeader) {
  if (!authHeader) return null;
  const m = authHeader.match(/^Basic\s+(.+)$/i);
  if (!m) return null;
  try {
    const decoded = Buffer.from(m[1], 'base64').toString('utf8');
    const idx = decoded.indexOf(':');
    if (idx < 0) return null;
    return { user: decoded.slice(0, idx), pass: decoded.slice(idx + 1) };
  } catch { return null; }
}

// ============================================================================
// CONNECTION ROUTER
// ============================================================================
function isHTTPMethodByte(b) {
  return [0x43, 0x47, 0x50, 0x44, 0x48, 0x4f, 0x54, 0x55, 0x4c, 0x45].includes(b);
}

function handleConnection(socket) {
  const clientIP = (socket.remoteAddress || '').replace(/^::ffff:/, '');
  if (clientIP && !ipAllowed(clientIP)) {
    logWarn(`IP ${clientIP} bị từ chối bởi whitelist/blacklist`);
    socket.destroy(); return;
  }
  if (clientIP && isAuthBlocked(clientIP)) {
    logWarn(`IP ${clientIP} bị chặn do auth fail`);
    socket.destroy(); return;
  }

  stats.total++;
  stats.current++;

  socket.setNoDelay(true);
  socket.setTimeout(HANDSHAKE_TIMEOUT_MS);

  const reader = new BufferedReader(socket);
  socket.once('timeout', () => { socket.destroy(); });

  reader.read(1).then(first => {
    socket.setTimeout(0);
    const b = first[0];
    reader.unread(first);
    if (b === 0x05) {
      return handleSOCKS5(socket, reader);
    } else if (isHTTPMethodByte(b)) {
      return handleHTTP(socket, reader);
    } else {
      logWarn(`Unknown protocol from ${clientIP}`);
      socket.destroy();
    }
  }).catch(() => {
    socket.destroy();
  }).finally(() => {
    stats.current--;
  });
}

