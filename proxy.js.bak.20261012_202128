async function dashboardAuth(req, res) {
  const ip = (req.socket.remoteAddress || '').replace(/^::ffff:/, '');
  const safeWrite = (code, headers, body) => {
    if (res.writableEnded || res.destroyed) return;
    try { res.writeHead(code, headers); res.end(body); } catch {}
  };
  if (isAuthBlocked(ip)) {
    safeWrite(429, { 'Content-Type': 'application/json' }, '{"error":"Too many requests"}');
    return null;
  }
  const authHeader = req.headers['authorization'] || '';
  if (authHeader.startsWith('Bearer ')) {
    const token = authHeader.slice(7);
    const th = hashAPIToken(token);
    const found = (appConfig.api_tokens || []).find(t => ctEqual(t.token_hash, th));
    if (found) { resetAuthFail(ip); return 'token:' + found.name; }
    recordAuthFail(ip, DASHBOARD_AUTH_FAIL_THRESHOLD);
    safeWrite(401, { 'Content-Type': 'application/json' }, '{"error":"Unauthorized (invalid token)"}');
    return null;
  }
  if (authHeader.startsWith('Basic ')) {
    let decoded = '';
    try { decoded = Buffer.from(authHeader.slice(6), 'base64').toString('utf8'); } catch {}
    const idx = decoded.indexOf(':');
    if (idx >= 0) {
      const u = decoded.slice(0, idx), p = decoded.slice(idx + 1);
      if (ctEqual(u, dashboardUser) && verifyPasswordCached(p, dashboardPassHash)) {
        resetAuthFail(ip);
        return 'dashboard:' + u;
      }
    }
  }
  recordAuthFail(ip, DASHBOARD_AUTH_FAIL_THRESHOLD);
  safeWrite(401, {
    'WWW-Authenticate': 'Basic realm="Dashboard"',
    'Content-Type': 'application/json',
  }, '{"error":"Unauthorized"}');
  return null;
}

const DASH_REQ_TIMEOUT_MS = 30000;

async function handleDashboardRequest(req, res) {
  let watchdogFired = false;
  const watchdog = setTimeout(() => {
    watchdogFired = true;
    if (!res.writableEnded && !res.destroyed) {
      try {
        res.writeHead(504, { 'Content-Type': 'application/json' });
        res.end('{"error":"request timeout"}');
      } catch {}
    }
    try { req.socket.destroy(); } catch {}
  }, DASH_REQ_TIMEOUT_MS);
  res.once('finish', () => clearTimeout(watchdog));
  res.once('close', () => clearTimeout(watchdog));

  try {
    await handleDashboardRequestInner(req, res);
  } catch (e) {
    if (!watchdogFired && !res.writableEnded && !res.destroyed) {
      try {
        res.writeHead(500, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify({ error: (e && e.message) || 'internal error' }));
      } catch {}
    }
  } finally {
    clearTimeout(watchdog);
  }
}

async function handleDashboardRequestInner(req, res) {
  const p = (req.url || '').split('?')[0];

  if (p === '/healthz') {
    res.writeHead(shuttingDown ? 503 : 200, { 'Content-Type': 'application/json' });
    return res.end(shuttingDown ? '{"status":"shutting_down"}' : '{"status":"ok"}');
  }
  if (p === '/metrics') {
    return metricsHandler(req, res);
  }

  const actor = await dashboardAuth(req, res);
  if (!actor) return;

  if (req.method === 'POST') {
    const ct = (req.headers['content-type'] || '').toLowerCase();
    if (!ct.startsWith('application/json')) {
      res.writeHead(403, { 'Content-Type': 'application/json' });
      return res.end('{"error":"CSRF check failed (content-type)"}');
    }
    const site = req.headers['sec-fetch-site'];
    if (site && site !== 'same-origin' && site !== 'none') {
      res.writeHead(403, { 'Content-Type': 'application/json' });
      return res.end('{"error":"CSRF check failed (sec-fetch-site)"}');
    }
    const origin = req.headers['origin'];
    if (origin) {
      let ok = false;
      try {
        const u = new URL(origin);
        const hostHeader = (req.headers['host'] || '').toLowerCase();
        if (u.host.toLowerCase() === hostHeader) ok = true;
      } catch {}
      if (!ok) {
        res.writeHead(403, { 'Content-Type': 'application/json' });
        return res.end('{"error":"CSRF check failed (origin)"}');
      }
    }
  }

  if (p === '/') {
    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
    return res.end(DASHBOARD_HTML);
  }
  if (p === '/api/all') {
    return sendJSON(res, 200, getAllStats());
  }
  if (p === '/api/stream') {
    return streamHandler(req, res);
  }
  if (p === '/api/kick') return await hKick(req, res, actor);
  if (p === '/api/users') return await hUsers(req, res, actor);
  if (p === '/api/users/delete') return await hDeleteUser(req, res, actor);
  if (p === '/api/tokens') return await hTokens(req, res, actor);
  if (p === '/api/tokens/delete') return await hDeleteToken(req, res, actor);
  if (p === '/api/audit-log') {
    return sendJSON(res, 200, { events: [...auditLog].reverse() });
  }
  if (p === '/api/reload-history') {
    return sendJSON(res, 200, { history: [...reloadHistory].reverse() });
  }
  if (p === '/api/network-config') return await hNetworkConfig(req, res, actor);
  if (p === '/api/reload') {
    const err = reloadConfig(actor);
    if (err) { res.writeHead(400); return res.end(JSON.stringify({ error: err })); }
    recordAudit(actor, 'reload_config', 'manual');
    return sendJSON(res, 200, { success: true });
  }
  if (p === '/api/change-password') return await hChangePassword(req, res, actor);
  if (p === '/api/config/export') {
    recordAudit(actor, 'export_config_backup', '');
    const data = JSON.stringify(appConfig, null, 2);
    res.writeHead(200, {
      'Content-Type': 'application/json',
      'Content-Disposition': `attachment; filename=proxy_config_backup_${Date.now()}.json`,
    });
    return res.end(data);
  }
  if (p === '/api/config/import') return await hImportConfig(req, res, actor);

  res.writeHead(404); res.end('{"error":"not found"}');
}

function sendJSON(res, code, obj) {
  const body = JSON.stringify(obj);
  res.writeHead(code, { 'Content-Type': 'application/json' });
  res.end(body);
}

const READ_BODY_TIMEOUT_MS = 30000;

async function readJSONBody(req, limit = 65536) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    let total = 0;
    let done = false;

    const cleanup = () => {
      clearTimeout(timer);
      req.removeListener('data', onData);
      req.removeListener('end', onEnd);
      req.removeListener('error', onErr);
      req.removeListener('aborted', onAbort);
    };
    const finish = (fn, val) => {
      if (done) return;
      done = true;
      cleanup();
      fn(val);
    };
    const timer = setTimeout(() => {
      try { req.destroy(); } catch {}
      finish(reject, new Error('request body timeout'));
    }, READ_BODY_TIMEOUT_MS);
    const onData = (c) => {
      if (done) return;
      total += c.length;
      if (total > limit) {
        try { req.destroy(); } catch {}
        return finish(reject, new Error('body too large'));
      }
      chunks.push(c);
    };
    const onEnd = () => {
      if (done) return;
      if (chunks.length === 0) return finish(resolve, {});
      try {
        const text = Buffer.concat(chunks).toString('utf8');
        finish(resolve, JSON.parse(text));
      } catch (e) {
        finish(reject, e);
      }
    };
    const onErr = (e) => finish(reject, e);
    const onAbort = () => finish(reject, new Error('request aborted'));

    req.on('data', onData);
    req.on('end', onEnd);
    req.on('error', onErr);
    req.on('aborted', onAbort);
  });
}

async function hKick(req, res, actor) {
  if (req.method !== 'POST') {
    res.writeHead(405); return res.end('{"error":"POST only"}');
  }
  let body;
  try { body = await readJSONBody(req, 2048); }
  catch (e) { res.writeHead(400); return res.end(JSON.stringify({ error: e.message })); }
  if (!body.id) { res.writeHead(400); return res.end('{"error":"missing id"}'); }
  const ci = activeConns.get(body.id);
  if (!ci) { res.writeHead(404); return res.end('{"error":"not found"}'); }
  try { ci.socket.destroy(); } catch {}
  logInfo(`Dashboard kicked ${ci.id} (${ci.ip} → ${ci.target})`);
  recordAudit(actor, 'kick_connection', `id=${ci.id} ip=${ci.ip} target=${ci.target} user=${ci.username}`);
  sendJSON(res, 200, { success: true, id: ci.id });
}

async function hUsers(req, res, actor) {
  if (req.method === 'GET') {
    return sendJSON(res, 200, {
      users: appConfig.users.map(u => ({
        username: u.username,
        max_bandwidth_bps: u.max_bandwidth_bps || 0,
        max_connections: u.max_connections || 0,
        quota_bytes_per_month: u.quota_bytes_per_month || 0,
        usage_bytes_this_month: getUsage(u.username),
      })),
    });
  }
  let body;
  try { body = await readJSONBody(req, 4096); }
  catch { res.writeHead(400); return res.end('{"error":"invalid JSON"}'); }
  const uname = String(body.username || '').trim();
  if (!uname || uname.length >= NAME_LEN) { res.writeHead(400); return res.end('{"error":"invalid username"}'); }
  const pwd = String(body.password || '');
  if (pwd && pwd.length < 4) { res.writeHead(400); return res.end('{"error":"password too short"}'); }
  const bw = Math.max(0, parseInt(body.max_bandwidth_bps, 10) || 0);
  const mc = Math.max(0, parseInt(body.max_connections, 10) || 0);
  const q = Math.max(0, parseInt(body.quota_bytes_per_month, 10) || 0);

  let existing = appConfig.users.find(u => u.username === uname);
  if (existing) {
    if (pwd) existing.password_hash = hashPassword(pwd);
    existing.max_bandwidth_bps = bw;
    existing.max_connections = mc;
    existing.quota_bytes_per_month = q;
  } else {
    if (!pwd) { res.writeHead(400); return res.end('{"error":"password required for new user"}'); }
    if (appConfig.users.length >= MAX_USERS) { res.writeHead(400); return res.end('{"error":"too many users"}'); }
    appConfig.users.push({
      username: uname,
      password_hash: hashPassword(pwd),
      max_bandwidth_bps: bw,
      max_connections: mc,
      quota_bytes_per_month: q,
    });
    appConfig.require_proxy_auth = true;
  }
  try { saveConfig(appConfig); }
  catch (e) { res.writeHead(500); return res.end(JSON.stringify({ error: e.message })); }
  applyLiveBandwidthLimit(uname, bw);
  logInfo(`Dashboard: upsert user '${uname}' (bw=${bw}, mc=${mc}, q=${q}, pwd_change=${!!pwd})`);
  recordAudit(actor, 'upsert_user', `username=${uname} bw=${bw} mc=${mc} q=${q} pwd_changed=${!!pwd}`);
  sendJSON(res, 200, { success: true });
}

async function hDeleteUser(req, res, actor) {
  let body;
  try { body = await readJSONBody(req, 2048); }
  catch { res.writeHead(400); return res.end('{"error":"invalid body"}'); }
  if (!body.username) { res.writeHead(400); return res.end('{"error":"missing username"}'); }
  const idx = appConfig.users.findIndex(u => u.username === body.username);
  if (idx < 0) { res.writeHead(404); return res.end('{"error":"not found"}'); }
  appConfig.users.splice(idx, 1);
  try { saveConfig(appConfig); }
  catch (e) { res.writeHead(500); return res.end(JSON.stringify({ error: e.message })); }
  logInfo(`Dashboard: deleted user '${body.username}'`);
  recordAudit(actor, 'delete_user', `username=${body.username}`);
  sendJSON(res, 200, { success: true });
}

async function hTokens(req, res, actor) {
  if (req.method === 'GET') {
    return sendJSON(res, 200, {
      tokens: appConfig.api_tokens.map(t => ({ name: t.name, created_at: t.created_at })),
    });
  }
  let body;
  try { body = await readJSONBody(req, 2048); }
  catch { res.writeHead(400); return res.end('{"error":"invalid body"}'); }
  const name = String(body.name || '').trim();
  if (!name) { res.writeHead(400); return res.end('{"error":"name required"}'); }
  if (name.length >= NAME_LEN) { res.writeHead(400); return res.end('{"error":"name too long"}'); }
  if (appConfig.api_tokens.find(t => t.name === name)) {
    res.writeHead(409); return res.end('{"error":"name exists"}');
  }
  if (appConfig.api_tokens.length >= MAX_TOKENS) {
    res.writeHead(400); return res.end('{"error":"too many tokens"}');
  }
  const token = generateAPIToken();
  appConfig.api_tokens.push({ name, token_hash: hashAPIToken(token), created_at: Math.floor(Date.now() / 1000) });
  try { saveConfig(appConfig); }
  catch (e) { res.writeHead(500); return res.end(JSON.stringify({ error: e.message })); }
  logInfo(`Dashboard: created token '${name}'`);
  recordAudit(actor, 'create_api_token', `name=${name}`);
  sendJSON(res, 200, { success: true, token, name });
}

async function hDeleteToken(req, res, actor) {
