  if (IS_DASHBOARD_LEADER && peerStats.size > 0) {
    for (const [wId, entry] of peerStats) {
      if (Date.now() - entry.t > 5000) continue;
      const p = entry.payload;
      localStats.total += p.total || 0;
      localStats.current += p.current || 0;
      localStats.active = (localStats.active || 0) + (p.current || 0);
      localStats.socks5_tcp += p.socks5TCP || 0;
      localStats.socks5_udp += p.socks5UDP || 0;
