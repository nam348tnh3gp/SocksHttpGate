// ============================================================================
// UTIL
// ============================================================================
function formatBytes(b) {
  if (b < 1024) return b + ' B';
  const u = ['B', 'KiB', 'MiB', 'GiB', 'TiB'];
  let i = 0; let v = b;
  while (v >= 1024 && i < u.length - 1) { v /= 1024; i++; }
  return v.toFixed(1) + ' ' + u[i];
}

function ctEqual(a, b) {
  const ba = Buffer.from(String(a));
  const bb = Buffer.from(String(b));
  if (ba.length !== bb.length) {
    let diff = ba.length ^ bb.length;
    const n = Math.max(ba.length, bb.length);
    for (let i = 0; i < n; i++) diff |= (ba[i] || 0) ^ (bb[i] || 0);
    return diff === 0;
  }
  return crypto.timingSafeEqual(ba, bb);
}

// ============================================================================
// IP / CIDR
// ============================================================================
function expandIPv6(ip) {
  if (!ip.includes(':')) return null;
  if (ip.includes('::')) {
    const [a, b] = ip.split('::');
    const left = a ? a.split(':') : [];
    const right = b ? b.split(':') : [];
    const zeros = 8 - left.length - right.length;
    if (zeros < 0) return null;
    return [...left, ...Array(zeros).fill('0'), ...right].join(':');
  }
  return ip.split(':').length === 8 ? ip : null;
}

function ipToBigInt(ip) {
  if (!ip) return null;
  if (ip.includes('.')) {
    const p = ip.split('.').map(x => parseInt(x, 10));
    if (p.length !== 4 || p.some(v => isNaN(v) || v < 0 || v > 255)) return null;
    return (BigInt(p[0]) << 24n) | (BigInt(p[1]) << 16n) | (BigInt(p[2]) << 8n) | BigInt(p[3]);
  }
  const e = expandIPv6(ip);
  if (!e) return null;
  let v = 0n;
  for (const g of e.split(':')) v = (v << 16n) | BigInt(parseInt(g, 16) || 0);
  return v;
}

function parseCIDR(cidr) {
  const [ip, bitsStr] = cidr.split('/');
  const bits = parseInt(bitsStr, 10);
  const isV6 = ip.includes(':');
  const totalBits = isV6 ? 128 : 32;
  if (isNaN(bits) || bits < 0 || bits > totalBits) return null;
  let v = ipToBigInt(ip);
  if (v === null) return null;
  if (!isV6) v = v & ((1n << 32n) - 1n);
  const mask = bits === 0 ? 0n : ((~0n << BigInt(totalBits - bits)) & ((1n << BigInt(totalBits)) - 1n));
  return { net: v & mask, mask, isV6, bits };
}

function ipInCIDR(ip, cidr) {
  const isV6 = ip.includes(':');
  if (isV6 !== cidr.isV6) return false;
  let v = ipToBigInt(ip);
  if (v === null) return false;
  if (!isV6) v = v & ((1n << 32n) - 1n);
  return (v & cidr.mask) === cidr.net;
}

// ============================================================================
// SSRF GUARD
// ============================================================================
const extraBlockedNets = ['0.0.0.0/8', '100.64.0.0/10', '192.0.0.0/24', '198.18.0.0/15']
  .map(parseCIDR).filter(Boolean);

function isBlockedIP(ipStr) {
  if (!ipStr) return true;
  ipStr = ipStr.split('%')[0];
  // Chuẩn hoá IPv4-mapped IPv6 (mọi biến thể hoa/thường).
  const lower = ipStr.toLowerCase();
  if (lower.startsWith('::ffff:')) ipStr = ipStr.slice(7);
  const v = ipToBigInt(ipStr);
  if (v === null) return true;
  const isV6 = ipStr.includes(':');
  for (const n of extraBlockedNets) {
    if (n.isV6 !== isV6) continue;
    let vv = isV6 ? v : (v & ((1n << 32n) - 1n));
    if ((vv & n.mask) === n.net) return true;
  }
  if (!isV6) {
    const a = Number((v >> 24n) & 0xffn);
    const b = Number((v >> 16n) & 0xffn);
    if (a === 0 || a === 10 || a === 127) return true;
    if (a === 169 && b === 254) return true;
    if (a === 172 && b >= 16 && b <= 31) return true;
    if (a === 192 && b === 168) return true;
    if (a === 100 && b >= 64 && b <= 127) return true;
    if (a === 198 && (b === 18 || b === 19)) return true;
    if (a >= 224) return true;
  } else {
    if (v === 0n || v === 1n) return true;
    if ((v >> 121n) === 0b1111110n) return true;
    if ((v >> 118n) === 0b1111111010n) return true;
    if ((v >> 120n) === 0xffn) return true;
  }
  return false;
}

function resolveAndCheck(host) {
  return new Promise((resolve, reject) => {
    if (/^\d+\.\d+\.\d+\.\d+$/.test(host) || host.includes(':')) {
      if (isBlockedIP(host)) return reject(new Error(`target IP ${host} bị chặn`));
      return resolve([host]);
    }
    dns.lookup(host, { all: true }, (err, addrs) => {
      if (err) return reject(err);
      if (!addrs.length) return reject(new Error(`không phân giải được host ${host}`));
      for (const a of addrs) {
        if (isBlockedIP(a.address)) {
          return reject(new Error(`target host ${host} phân giải ra IP nội bộ (${a.address}), bị chặn`));
        }
      }
      resolve(addrs.map(a => a.address));
    });
  });
}

// ============================================================================
// IP WHITELIST/BLACKLIST
// ============================================================================
let allowedCIDRs = [];
let deniedCIDRs = [];

function parseCIDRList(items) {
  const result = [], invalid = [];
  for (const raw of items || []) {
    const s = String(raw || '').trim();
    if (!s) continue;
    const cidr = s.includes('/') ? s : (s + (s.includes(':') ? '/128' : '/32'));
    const n = parseCIDR(cidr);
    if (!n) { invalid.push(s); logWarn(`CIDR không hợp lệ, bỏ qua: ${s}`); continue; }
    result.push(n);
  }
  return { result, invalid };
}

function ipAllowed(ipStr) {
  if (!ipStr) return false;
  for (const d of deniedCIDRs) if (ipInCIDR(ipStr, d)) return false;
  if (allowedCIDRs.length === 0) return true;
  for (const a of allowedCIDRs) if (ipInCIDR(ipStr, a)) return true;
  return false;
}

// ============================================================================
// BRUTE-FORCE PROTECTION
// ============================================================================
const failCounts = new Map();
const failLastFail = new Map();
const blockedUntil = new Map();

function recordAuthFail(ip, threshold) {
  if (!ip) return;
  const now = Date.now();
  const last = failLastFail.get(ip) || 0;
  if (last && now - last > AUTH_FAIL_WINDOW_MS) failCounts.set(ip, 0);
  failLastFail.set(ip, now);
  const c = (failCounts.get(ip) || 0) + 1;
  if (c >= threshold) {
    blockedUntil.set(ip, now + AUTH_BLOCK_DURATION_MS);
    logWarn(`IP ${ip} bị chặn ${AUTH_BLOCK_DURATION_MS / 60000} phút do auth fail quá ${threshold} lần`);
    failCounts.set(ip, 0);
  } else {
    failCounts.set(ip, c);
  }
}

function resetAuthFail(ip) {
  if (!ip) return;
  failCounts.delete(ip);
  failLastFail.delete(ip);
  blockedUntil.delete(ip);
}

function isAuthBlocked(ip) {
  if (!ip) return false;
  const until = blockedUntil.get(ip);
  if (!until) return false;
  if (Date.now() > until) { blockedUntil.delete(ip); return false; }
  return true;
}

// ============================================================================
// CRYPTO: PASSWORD HASH + CACHE
// ============================================================================
function hashPassword(password) {
  const salt = crypto.randomBytes(16);
  const dg = crypto.pbkdf2Sync(String(password), salt, HASH_ITERATIONS, 32, 'sha256');
  return `${HASH_ITERATIONS}:${salt.toString('hex')}:${dg.toString('hex')}`;
}

function verifyPassword(password, stored) {
  if (!stored || stored.length > PW_HASH_MAX) return false;
  const parts = String(stored).split(':');
  if (parts.length !== 3) return false;
  const iters = parseInt(parts[0], 10);
  if (!iters || iters <= 0 || iters > HASH_MAX_ITERATIONS) return false;
  let salt, want;
  try {
    salt = Buffer.from(parts[1], 'hex');
    want = Buffer.from(parts[2], 'hex');
  } catch { return false; }
  if (want.length !== 32) return false;
  const got = crypto.pbkdf2Sync(String(password), salt, iters, 32, 'sha256');
  return crypto.timingSafeEqual(got, want);
}

const pwCache = new Map();
function verifyPasswordCached(password, stored) {
  const key = crypto.createHash('sha256').update(String(stored) + '\x00' + String(password)).digest('hex');
  const now = Date.now();
  const exp = pwCache.get(key);
  if (exp && exp > now) return true;
  if (!verifyPassword(password, stored)) return false;
  if (pwCache.size >= 1024) {
    for (const [k, e] of pwCache) if (e <= now) pwCache.delete(k);
    if (pwCache.size >= 1024) pwCache.clear();
  }
  pwCache.set(key, now + PW_CACHE_TTL_MS);
  return true;
}

