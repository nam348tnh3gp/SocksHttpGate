function parseArgs(argv) {
  const a = {
    l: '0.0.0.0', p: 1080, u: '', P: '', 'force-kill': false,
    'no-udp': false, upstream: '', cert: '', key: '',
    'dashboard-port': 8081, 'dashboard-bind': '127.0.0.1',
    config: 'proxy_config.json', 'dashboard-user': 'admin',
    'dashboard-pass': '', allow: '', deny: '',
    'usage-file': 'proxy_usage.json', 'log-file': '',
    'log-max-size-mb': 20, 'log-max-backups': 5,
    'single-port': false, help: false,
  };
  for (let i = 2; i < argv.length; i++) {
    let k = argv[i];
    if (!k.startsWith('-')) continue;
    k = k.replace(/^--?/, '');
    const next = argv[i + 1];
    if (k === 'help' || k === 'h') { a.help = true; continue; }
    if (['force-kill', 'no-udp', 'single-port'].includes(k)) { a[k] = true; continue; }
    if (next === undefined || (next.startsWith('-') && isNaN(parseInt(next, 10)))) {
      a[k] = true; continue;
    }
    i++;
    if (['p', 'dashboard-port', 'log-max-size-mb', 'log-max-backups'].includes(k)) {
      a[k] = parseInt(next, 10);
    } else {
      a[k] = next;
    }
  }
  return a;
}

