async function hNetworkConfig(req, res, actor) {
  if (req.method === 'GET') {
    return sendJSON(res, 200, {
      allow_list: appConfig.allow_list || [],
      deny_list: appConfig.deny_list || [],
      upstream_proxies: appConfig.upstream_proxies || [],
    });
  }
  let body;
  try { body = await readJSONBody(req, 65536); }
  catch { res.writeHead(400); return res.end('{"error":"invalid body"}'); }
  appConfig.allow_list = Array.isArray(body.allow_list) ? body.allow_list : [];
  appConfig.deny_list = Array.isArray(body.deny_list) ? body.deny_list : [];
  appConfig.upstream_proxies = Array.isArray(body.upstream_proxies) ? body.upstream_proxies : [];
  try { saveConfig(appConfig); }
  catch (e) { res.writeHead(500); return res.end(JSON.stringify({ error: e.message })); }
  const err = reloadConfig(actor);
  if (err) { res.writeHead(500); return res.end(JSON.stringify({ error: err })); }
  recordAudit(actor, 'update_network_config', '');
  sendJSON(res, 200, { success: true });
}

async function hChangePassword(req, res, actor) {
  let body;
  try { body = await readJSONBody(req, 4096); }
  catch { res.writeHead(400); return res.end('{"error":"invalid body"}'); }
  const cur = String(body.current_password || '');
  const nu = String(body.new_username || '').trim();
  const np = String(body.new_password || '');
  if (!verifyPassword(cur, dashboardPassHash)) {
    res.writeHead(403); return res.end('{"error":"current password incorrect"}');
  }
  if (np.length < 8) { res.writeHead(400); return res.end('{"error":"password too short"}'); }
  if (np === cur) { res.writeHead(400); return res.end('{"error":"same password"}'); }
  const newHash = hashPassword(np);
  const oldUser = dashboardUser;
  dashboardPassHash = newHash;
  if (nu) dashboardUser = nu;
  appConfig.dashboard_user = dashboardUser;
  appConfig.dashboard_password_hash = dashboardPassHash;
  try { saveConfig(appConfig); }
  catch (e) { logWarn(`Đổi mật khẩu OK nhưng không ghi được config: ${e.message}`); }
  logInfo(`Dashboard creds changed: ${oldUser} → ${dashboardUser}`);
  recordAudit(actor, 'change_dashboard_password', `user: ${oldUser} → ${dashboardUser}`);
  sendJSON(res, 200, { success: true, username: dashboardUser });
}

async function hImportConfig(req, res, actor) {
  let body;
  try { body = await readJSONBody(req, 5 * 1024 * 1024); }
  catch (e) { res.writeHead(400); return res.end(JSON.stringify({ error: e.message })); }
  if (!body || typeof body !== 'object' || !body.dashboard_user || !body.dashboard_password_hash) {
    res.writeHead(400); return res.end('{"error":"not a valid backup"}');
  }
  body.users = body.users || [];
  body.allow_list = body.allow_list || [];
  body.deny_list = body.deny_list || [];
  body.upstream_proxies = body.upstream_proxies || [];
  body.api_tokens = body.api_tokens || [];
  parseCIDRList(body.allow_list);
  parseCIDRList(body.deny_list);
  try { saveConfigSync(body); }
  catch (e) { res.writeHead(500); return res.end(JSON.stringify({ error: e.message })); }
  const err = reloadConfig(actor);
  if (err) { res.writeHead(500); return res.end(JSON.stringify({ error: err })); }
  recordAudit(actor, 'import_config_backup', `${body.users.length} users, ${body.api_tokens.length} tokens`);
  logInfo('Dashboard: config restored from backup');
  sendJSON(res, 200, { success: true });
}

