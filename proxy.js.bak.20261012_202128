    catch (e) { throw new Error(`config file lỗi định dạng JSON: ${e.message}`); }
    if (!cfg.dashboard_user || !cfg.dashboard_password_hash) {
      throw new Error('config file thiếu dashboard_user/dashboard_password_hash');
    }
    cfg.users = cfg.users || [];
    cfg.allow_list = cfg.allow_list || [];
    cfg.deny_list = cfg.deny_list || [];
    cfg.upstream_proxies = cfg.upstream_proxies || [];
    cfg.api_tokens = cfg.api_tokens || [];
    return { cfg, created: false };
  }
  const cfg = {
    dashboard_user: args['dashboard-user'] || 'admin',
    dashboard_password_hash: hashPassword(args['dashboard-pass']),
    users: [], allow_list: [], deny_list: [], upstream_proxies: [], api_tokens: [],
    require_proxy_auth: false,
  };
  saveConfigSync(cfg);
  logInfo(`Đã tạo config file mới tại ${configPath}`);
  return { cfg, created: true };
}

// Ghi đồng bộ chỉ dùng ở luồng khởi động (loadOrInitConfig).
function saveConfigSync(cfg) {
  const data = JSON.stringify(cfg, null, 2);
  const tmp = configPath + '.tmp';
  try {
    fs.writeFileSync(tmp, data, { mode: 0o600 });
    fs.renameSync(tmp, configPath);
  } catch (e) {
    try { fs.writeFileSync(configPath, data, { mode: 0o600 }); }
    catch { throw e; }
  }
}

// Ghi bất đồng bộ cho runtime (dashboard action) — không block event loop khi disk chậm.
let _configSavePending = false;
let _configSaveQueued = false;
let _configSaveQueuedCfg = null;
function saveConfig(cfg) {
  if (_configSavePending) { _configSaveQueued = true; _configSaveQueuedCfg = cfg; return; }
  _configSavePending = true;
  let data;
  try { data = JSON.stringify(cfg, null, 2); }
  catch (e) { _configSavePending = false; logWarn(`Không serialize được config: ${e.message}`); return; }
  const tmp = configPath + '.tmp';
  fs.writeFile(tmp, data, { mode: 0o600 }, (err) => {
    if (err) {
      _configSavePending = false;
      logWarn(`Không ghi được config tmp: ${err.message}`);
      if (_configSaveQueued) { _configSaveQueued = false; const c = _configSaveQueuedCfg; _configSaveQueuedCfg = null; saveConfig(c); }
      return;
    }
    fs.rename(tmp, configPath, (err2) => {
      _configSavePending = false;
      if (err2) logWarn(`Không rename được config: ${err2.message}`);
      if (_configSaveQueued) { _configSaveQueued = false; const c = _configSaveQueuedCfg; _configSaveQueuedCfg = null; saveConfig(c); }
    });
  });
}

// ============================================================================
// USAGE / QUOTA
// ============================================================================
let usage = {};
const usagePath = args['usage-file'] || 'proxy_usage.json';

function currentPeriod() {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
}

function loadUsage() {
  if (!usagePath || !fs.existsSync(usagePath)) return;
  try {
    const data = JSON.parse(fs.readFileSync(usagePath, 'utf8'));
    if (data && typeof data === 'object') usage = data;
  } catch (e) { logWarn(`File usage lỗi định dạng, bỏ qua: ${e.message}`); }
}

let _usageSavePending = false;
let _usageSaveQueued = false;
function saveUsage() {
  if (!usagePath) return;
  if (_usageSavePending) { _usageSaveQueued = true; return; }
  _usageSavePending = true;
  let data;
  try { data = JSON.stringify(usage, null, 2); }
  catch (e) { _usageSavePending = false; logWarn(`Không serialize được usage: ${e.message}`); return; }
  const tmp = usagePath + '.tmp';
  fs.writeFile(tmp, data, (err) => {
    if (err) {
      _usageSavePending = false;
      logWarn(`Không ghi được usage tmp: ${err.message}`);
      if (_usageSaveQueued) { _usageSaveQueued = false; saveUsage(); }
      return;
    }
    fs.rename(tmp, usagePath, (err2) => {
      _usageSavePending = false;
      if (err2) logWarn(`Không rename được usage: ${err2.message}`);
      if (_usageSaveQueued) { _usageSaveQueued = false; saveUsage(); }
    });
  });
}

function addUsage(username, bytes) {
  if (!username || bytes <= 0) return;
  const per = currentPeriod();
  const rec = usage[username];
  if (!rec || rec.period !== per) usage[username] = { period: per, bytes_used: bytes };
  else rec.bytes_used += bytes;
}

function getUsage(username) {
  const per = currentPeriod();
  const rec = usage[username];
  if (!rec || rec.period !== per) return 0;
  return rec.bytes_used || 0;
}

const isOverQuota = (username, quotaBytes) => quotaBytes > 0 && getUsage(username) >= quotaBytes;

