#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
fix_active_conns.py — Fix nút Kick + tracking active connections.

Bao gồm cả fix_kick (chưa áp) + cải tiến:
  1. Lưu client_sock / remote_sock / udp_sock vào info map
  2. close_conn: close socket (không kill) → handler return tự nhiên → after → remove_conn
  3. Watchdog 500ms force-delete nếu vẫn còn entry
  4. Monitor pid: khi handler chết (bất kể lý do) → auto cleanup ETS
  5. all_conns: filter connection có pid đã chết (defense-in-depth)
  6. gc_dead_conns: quét định kỳ 5s, xoá entry orphan
  7. inc_conn: chỉ update nếu key tồn tại, không re-create
  8. Debug endpoint /api/debug/conns

Idempotent. Backup timestamp.
"""
import sys, time, shutil
from pathlib import Path

TARGET = Path(sys.argv[1] if len(sys.argv) > 1 else "proxy.exs")

def sub_once(s, old, new, label):
    if old in s:
        print(f"[ OK ] {label}")
        return s.replace(old, new, 1)
    probe = new.strip().splitlines()[0][:60]
    if probe and probe in s:
        print(f"[SKIP] {label}")
        return s
    print(f"[MISS] {label}")
    return s

def main():
    if not TARGET.exists():
        print("Không tìm thấy:", TARGET); sys.exit(1)
    ts = time.strftime("%Y%m%d_%H%M%S")
    bak = TARGET.with_suffix(TARGET.suffix + f".{ts}.bak")
    shutil.copy2(TARGET, bak)
    print(f"Backup -> {bak}\n")

    src = TARGET.read_text(encoding="utf-8")
    orig = src

