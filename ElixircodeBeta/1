  defp close_sock({:tcp, s}) do
    try do :gen_tcp.close(s) rescue _ -> :ok catch _, _ -> :ok end
  end
  defp close_sock({:udp, s}) do
    try do :gen_udp.close(s) rescue _ -> :ok catch _, _ -> :ok end
  end
  defp close_sock(_), do: :ok''',
        'P.State: add_conn watch + all_conns filter + gc + close_conn socket')

