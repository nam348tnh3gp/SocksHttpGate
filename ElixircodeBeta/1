          [{^id, uu, dd}] -> {uu, dd}
          [] -> {0, 0}
        end
        i |> Map.put(:bytes_up, u) |> Map.put(:bytes_down, d)
      [] -> nil
    end
  end

  def all_conns do
    :ets.tab2list(:p_conns)
    |> Enum.map(fn {id, info} ->
      {u, d} = case :ets.lookup(:p_conn_bytes, id) do
        [{^id, uu, dd}] -> {uu, dd}
        [] -> {0, 0}
      end
      info
      |> Map.put(:bytes_up, u)
      |> Map.put(:bytes_down, d)
      |> Map.put_new(:start, System.system_time(:second))
      |> Map.put_new(:user, "")
      |> Map.put_new(:target, "N/A")
    end)
  end

  def inc_conn(id, :up, n) when n > 0 do
    :ets.update_counter(:p_conn_bytes, id, {2, n}, {id, 0, 0})
  rescue
    _ -> 0
  end
  def inc_conn(id, :down, n) when n > 0 do
    :ets.update_counter(:p_conn_bytes, id, {3, n}, {id, 0, 0})
  rescue
    _ -> 0
  end
  def inc_conn(_, _, _), do: :ok

  def close_conn(id) do
    case :ets.lookup(:p_conns, id) do
      [{^id, %{pid: pid}}] when is_pid(pid) ->
        Process.exit(pid, :kill)
      _ -> :ok
    end
  end''',
'''  def add_conn(id, info) do
    :ets.insert(:p_conns, {id, info})
    :ets.insert(:p_conn_bytes, {id, 0, 0})
    case Map.get(info, :pid) do
      pid when is_pid(pid) ->
        GenServer.cast(__MODULE__, {:watch_conn, id, pid})
      _ -> :ok
    end
    :ok
  end

  def remove_conn(id) do
    :ets.delete(:p_conns, id)
    :ets.delete(:p_conn_bytes, id)
    :ok
  end

  def get_conn(id) do
    case :ets.lookup(:p_conns, id) do
      [{^id, i}] ->
        {u, d} = case :ets.lookup(:p_conn_bytes, id) do
          [{^id, uu, dd}] -> {uu, dd}
          [] -> {0, 0}
        end
        i |> Map.put(:bytes_up, u) |> Map.put(:bytes_down, d)
      [] -> nil
    end
  end

  def all_conns do
    :ets.tab2list(:p_conns)
    |> Enum.filter(fn {_id, info} -> conn_alive?(info) end)
    |> Enum.map(fn {id, info} ->
      {u, d} = case :ets.lookup(:p_conn_bytes, id) do
        [{^id, uu, dd}] -> {uu, dd}
        [] -> {0, 0}
      end
      info
      |> Map.put(:id, Map.get(info, :id, id))
      |> Map.put(:bytes_up, u)
      |> Map.put(:bytes_down, d)
      |> Map.put_new(:start, System.system_time(:second))
      |> Map.put_new(:user, "")
      |> Map.put_new(:target, "N/A")
    end)
  end

  defp conn_alive?(info) do
    case Map.get(info, :pid) do
      pid when is_pid(pid) -> Process.alive?(pid)
      _ -> true
    end
  end

