package main
import("bytes";"context";"encoding/json";"fmt";"io";"log";"net/http";"net/url";"os";"strings";"sync/atomic";"time")
const(odohType="application/oblivious-dns-message";maxBody=65535)
type proxy struct{target *url.URL;client *http.Client;started time.Time;requests,errors atomic.Uint64}
func main(){raw:=strings.TrimSpace(os.Getenv("ODOH_TARGET_URL"));u,e:=url.Parse(raw);if raw==""||e!=nil||u.Host==""||u.User!=nil||u.RawQuery!=""||u.Fragment!=""||(u.Scheme!="https"&&!(u.Scheme=="http"&&os.Getenv("ALLOW_INSECURE_TARGET")=="YES")){log.Fatal("ODOH_TARGET_URL must be a fixed HTTPS origin; HTTP only with ALLOW_INSECURE_TARGET=YES on a trusted private network")};if u.Path!=""&&u.Path!="/"{log.Fatal("ODOH_TARGET_URL must not include a path")};p:=&proxy{target:u,client:&http.Client{Timeout:10*time.Second,CheckRedirect:func(*http.Request,[]*http.Request)error{return http.ErrUseLastResponse}},started:time.Now()};mux:=http.NewServeMux();mux.HandleFunc("/health",p.health);mux.HandleFunc("/api/stats",p.stats);mux.HandleFunc("/api/v1/health",p.health);mux.HandleFunc("/api/v1/stats",p.stats);mux.HandleFunc("/api/v1/status",p.apiStatus);mux.HandleFunc("/.well-known/odohconfigs",p.configs);mux.HandleFunc("/proxy",p.query);addr:=env("ADDR",":"+env("PORT","8080"));srv:=&http.Server{Addr:addr,Handler:headers(mux),ReadHeaderTimeout:5*time.Second,ReadTimeout:10*time.Second,WriteTimeout:12*time.Second,IdleTimeout:60*time.Second,MaxHeaderBytes:16<<10};log.Printf("ODoH Proxy started; target_origin=%s; per-query logging disabled",u.Scheme+"://"+u.Host);cert,key:=os.Getenv("TLS_CERT"),os.Getenv("TLS_KEY");if cert!=""&&key!=""{log.Fatal(srv.ListenAndServeTLS(cert,key))};log.Fatal(srv.ListenAndServe())}
func(p *proxy)configs(w http.ResponseWriter,r *http.Request){if r.Method!="GET"{http.Error(w,"method not allowed",405);return};p.forward(w,r,"/.well-known/odohconfigs",false)}
func(p *proxy)query(w http.ResponseWriter,r *http.Request){if r.Method!="POST"{http.Error(w,"method not allowed",405);return};if media(r.Header.Get("Content-Type"))!=odohType{http.Error(w,"unsupported media type",415);return};p.forward(w,r,"/proxy",true)}
func(p *proxy)forward(w http.ResponseWriter,r *http.Request,path string,withBody bool){var body io.Reader;if withBody{b,e:=io.ReadAll(http.MaxBytesReader(w,r.Body,maxBody));if e!=nil{http.Error(w,"invalid request body",400);return};body=bytes.NewReader(b)};u:=*p.target;u.Path=path;req,e:=http.NewRequestWithContext(r.Context(),r.Method,u.String(),body);if e!=nil{p.errors.Add(1);http.Error(w,"Target unavailable",502);return};if withBody{req.Header.Set("Content-Type",odohType);req.Header.Set("Accept",odohType)};resp,e:=p.client.Do(req);if e!=nil{p.errors.Add(1);http.Error(w,"Target unavailable",502);return};defer resp.Body.Close();if resp.StatusCode<200||resp.StatusCode>299{p.errors.Add(1);http.Error(w,fmt.Sprintf("Target returned HTTP %d",resp.StatusCode),502);return};b,e:=io.ReadAll(io.LimitReader(resp.Body,maxBody+1));if e!=nil||len(b)>maxBody{p.errors.Add(1);http.Error(w,"invalid Target response",502);return};ct:=media(resp.Header.Get("Content-Type"));if withBody&&ct!=odohType{p.errors.Add(1);http.Error(w,"invalid Target content type",502);return};if withBody{p.requests.Add(1)};if ct!=""{w.Header().Set("Content-Type",ct)};if cc:=resp.Header.Get("Cache-Control");cc!=""{w.Header().Set("Cache-Control",cc)};w.WriteHeader(resp.StatusCode);_,_=w.Write(b)}
func(p *proxy)health(w http.ResponseWriter,r *http.Request){if r.Method!="GET"{http.Error(w,"method not allowed",405);return};ctx,cancel:=context.WithTimeout(r.Context(),2*time.Second);defer cancel();u:=*p.target;u.Path="/health";req,e:=http.NewRequestWithContext(ctx,http.MethodGet,u.String(),nil);if e!=nil{http.Error(w,"target unavailable",http.StatusServiceUnavailable);return};resp,e:=p.client.Do(req);if e!=nil{http.Error(w,"target unavailable",http.StatusServiceUnavailable);return};defer resp.Body.Close();if resp.StatusCode<200||resp.StatusCode>=300{http.Error(w,"target unavailable",http.StatusServiceUnavailable);return};w.Header().Set("Content-Type","text/plain");_,_=io.WriteString(w,"ok\n")}
func(p *proxy)apiStatus(w http.ResponseWriter,r *http.Request){if r.Method!="GET"{http.Error(w,"method not allowed",405);return};w.Header().Set("Content-Type","application/json");w.Header().Set("Cache-Control","no-store");_=json.NewEncoder(w).Encode(map[string]any{"service":"odoh-proxy","status":"running","protocol":"RFC 9230 ODoH","uptime_seconds":int64(time.Since(p.started).Seconds())})}
func(p *proxy)stats(w http.ResponseWriter,r *http.Request){if r.Method!="GET"{http.Error(w,"method not allowed",405);return};w.Header().Set("Content-Type","application/json");w.Header().Set("Cache-Control","no-store");_=json.NewEncoder(w).Encode(map[string]any{"ready":true,"uptime_seconds":int64(time.Since(p.started).Seconds()),"forwarded_queries":p.requests.Load(),"errors":p.errors.Load(),"privacy_mode":"opaque forwarding; no client IP, domain, or query logging"})}
func media(s string)string{return strings.ToLower(strings.TrimSpace(strings.SplitN(s,";",2)[0]))}
func headers(next http.Handler)http.Handler{return http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){w.Header().Set("X-Content-Type-Options","nosniff");next.ServeHTTP(w,r)})}
func env(k,d string)string{if v:=strings.TrimSpace(os.Getenv(k));v!=""{return v};return d}
